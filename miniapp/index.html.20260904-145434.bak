<!-- ============ SCAN (analysis) ============ -->
<div class="screen" id="s-scan">
  <div class="topbar"><div class="brand">Analysis</div><div class="wallet" id="wallet-scan">â€¦</div></div>
  <div class="wrap">
    <div class="warhead">
      <div class="warhead-top">
        <span class="warhead-badge">â—ˆ WAR ENGINE</span>
        <span class="warhead-tag">deterministic market intelligence</span>
      </div>
      <div class="warhead-body">WAR ARENA reads live on-chain data from GMGN and runs it through a deterministic engine to surface structure â€” concentration, liquidity depth, organic activity, contract integrity and more. It shows you <b>how a token is built</b>, not what to do.</div>
      <div class="warhead-note">âš  This is analysis, <b>not financial advice</b>. Signals can be wrong or incomplete. Always do your own research â€” you alone are responsible for your decisions.</div>
    </div>
    <div id="promo-banner" style="display:none;background:linear-gradient(90deg,rgba(79,208,168,.16),rgba(91,140,255,.16));border:1px solid rgba(79,208,168,.4);border-radius:12px;padding:11px 14px;margin-bottom:12px;font-size:13px;color:var(--ink);text-align:center"></div>
    <div class="card">
      <div id="chainDetected" class="chain-detected">Paste an address â€” chain is detected automatically</div>
      <div class="searchbar">
        <input id="tokenInput" placeholder="Search token by name or paste address" autocomplete="off" spellcheck="false" />
        <button class="btn" id="scanBtn">Scan</button>
      </div>
      <div id="searchResults" class="search-results"></div>
      <div class="muted" id="scanCost">3 free scans/day Â· then $0.10 each</div>
    </div>
    <div id="scanResult"></div>
  </div>
</div>

<!-- ============ ACCOUNT ============ -->
<div class="screen" id="s-account">
  <div class="topbar"><div class="brand">My Account</div><div class="wallet" id="wallet-acct">â€¦</div></div>
  <div class="wrap">
    <div class="card" style="text-align:center">
      <div class="card-t">Balance</div>
      <div class="big-num" id="acct-balance">$0.00</div>
      <div class="muted" id="acct-free">3 free scans left today</div>
      <div><span class="tier" id="acct-tier">STANDARD</span></div>
    </div>
    <div class="card">
      <div class="card-t">Top up balance</div>
      <div id="packs"></div>
    </div>
    <div class="card">
      <div class="card-t">Your active monitors</div>
      <div id="monitors"><div class="muted">No active monitors</div></div>
    </div>

    <!-- Referral program â€” gamified, share-worthy -->
    <div class="card refcard">
      <div class="refglow"></div>
      <div class="refeyebrow">âš” INVITE SQUAD</div>
      <div class="reftitle">Recruit 10 â†’ unlock a free 24h monitor</div>
      <div class="refsub">Every warrior you bring earns you closer to a free token monitor. Share your battle link.</div>

      <div class="refprogress">
        <div class="refprogress-bar"><div class="refprogress-fill" id="ref-fill"></div></div>
        <div class="refprogress-label"><span id="ref-count">0</span> / <span id="ref-target">10</span> recruited Â· <span id="ref-remain">10</span> to go</div>
      </div>

      <div class="refstats">
        <div class="refstat"><div class="refstat-num" id="ref-invited">0</div><div class="refstat-lbl">RECRUITED</div></div>
        <div class="refstat"><div class="refstat-num" id="ref-earned">0</div><div class="refstat-lbl">MONITORS EARNED</div></div>
      </div>

      <div class="reflink" id="ref-link-box" style="display:none">
        <input id="ref-link" class="reflink-input" readonly/>
        <button class="btn gold reflink-btn" id="ref-share">Share âš”</button>
      </div>
      <button class="btn ghost" id="ref-claim" style="display:none;margin-top:8px">Claim your reward</button>
    </div>

    <!-- WAR Founder Wallet â€” public identity + transparency (per spec) -->
    <div class="card fwcard">
      <div class="fweyebrow">â—† WAR FOUNDER WALLET Â· PUBLIC</div>
      <div class="fwident">2 chains Â· 1 identity</div>
      <div class="fwsub">The official public WAR wallet. Verify it yourself on-chain â€” transparency you don't have to trust.</div>
      <div class="fwfollow">
        <button class="btn gold" id="fw-follow">Follow</button>
        <div class="fwcount"><span id="fw-count">â€”</span> followers</div>
      </div>
      <div id="fw-addrs"></div>
      <div class="fwsafety">
        <div class="fwsafe-line">WAR will never ask for your seed phrase, private key, or funds.</div>
        <div class="fwsafe-line">WAR has no token and will never launch one.</div>
        <div class="fwsafe-line">Tokens received here are <b>not</b> endorsements â€” WAR analysis stays independent.</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ WALLET WATCH ============ -->
<div class="screen" id="s-watch">
  <div class="topbar"><div class="brand">Wallet Watch</div><div class="wallet" id="wallet-watch">â€¦</div></div>
  <div class="wrap">

    <div class="card wintro">
      <div class="weyebrow">â—‰ WALLET WATCH</div>
      <div class="wpitch">Track wallets' every buy &amp; sell â€” live. Get alerted when your watched wallets <b>converge</b> on the same token, or <b>dump</b> a position. One subscription, many wallets.</div>
      <div id="ww-tiers" class="wtiers"></div>
    </div>

    <div class="card">
      <div class="card-t">Watch a wallet</div>
      <div class="wfield">
        <input id="ww-addr" class="winput" placeholder="Paste wallet address" autocomplete="off" spellcheck="false"/>
        <div class="chain-detected" id="ww-detected">Chain is detected from the address</div>
      </div>
      <div class="wbtns">
        <button class="btn ghost" id="ww-check">Check reputation</button>
        <button class="btn gold" id="ww-sub">Add to watchlist</button>
      </div>
      <div id="ww-rep"></div>
    </div>

    <div class="card">
      <div class="card-t">Your watched wallets</div>
      <div id="ww-list"><div class="muted">No watched wallets yet</div></div>
    </div>

    <div class="card">
      <div class="card-t">Alerts feed</div>
      <div id="ww-feed"><div class="muted">Alerts from your watched wallets will appear here â€” buys, sells, convergence, and dump warnings.</div></div>
    </div>

  </div>
</div>

<!-- ============ nav ============ -->
<div class="nav">
  <button class="on" data-s="galaxy"><span class="ic">âœ¦</span>Arena</button>
  <button data-s="scan"><span class="ic">â—Ž</span>Analysis</button>
  <button data-s="watch"><span class="ic">â—‰</span>Watch</button>
  <button data-s="account"><span class="ic">â–¤</span>My Account</button>
</div>

<script>
/* WAR ARENA â€” Telegram Mini App shell.
 * Three UX layers per the design doc: browse (galaxy, free) -> scan (analysis,
 * free-quota then paid) -> account (balance/tier/packs/monitors).
 * Wired to the WAR HTTP API. GMGN live = through the API. This is the SHELL:
 * it runs locally in a browser and inside Telegram; real data needs the API
 * base URL + a deployed server + bot token (payment). No fake intelligence â€”
 * when the API is unset it shows an honest "connect API" state. */

// ==== LEGAL: mandatory consent gate =========================================
const LEGAL_VERSION = "2026-01-v1"; // bump when terms change -> re-prompt
const TERMS_HTML = `
<h3 style="color:#eef2f8">WAR Arena â€” Terms of Service</h3>
<p style="color:#5a6577;font-family:monospace;font-size:11px">Version ${LEGAL_VERSION}</p>
<p><b style="color:#eef2f8">1. What WAR Arena is.</b> WAR Arena ("the Service") is an analytics tool that displays on-chain market signals for Solana tokens. Data is sourced from third parties, primarily GMGN, and surfaced through the Service. The Service runs as a Telegram Mini App.</p>
<p><b style="color:#eef2f8">2. Not financial advice.</b> The Service is informational only. Nothing in it is investment, financial, legal, or tax advice, an offer, or a solicitation to buy or sell any asset. Signals, scores (power, threat, confidence, attention), states, and events are analytical outputs, not predictions or recommendations. You are solely responsible for your decisions. Cryptocurrency trading involves substantial risk, including total loss of funds.</p>
<p><b style="color:#eef2f8">3. No warranty on data.</b> Data may be incomplete, delayed, inaccurate, or unavailable, and may be explicitly marked INSUFFICIENT. The Service depends on third-party sources (GMGN) and infrastructure (Telegram, TON) that we do not control and cannot guarantee. The Service is provided "as is" and "as available" without warranties of any kind.</p>
<p><b style="color:#eef2f8">4. Eligibility.</b> You must be of legal age in your jurisdiction and legally permitted to use crypto-analytics and payment services where you live. You are responsible for compliance with your local laws, including any restrictions on crypto assets.</p>
<p><b style="color:#eef2f8">5. Payments & credit.</b> Scans, monitoring, and credit packs are paid via Telegram Stars or TON. Prices are shown before purchase. Purchased credit and the WAR COMMAND tier are consumed as used and are digital goods delivered immediately; except where required by law or stated in our refund policy, purchases are final. Free scans are a limited promotional grant and carry no cash value.</p>
<p><b style="color:#eef2f8">6. Acceptable use.</b> You will not misuse the Service, attempt to circumvent limits or payment, reverse-engineer the intelligence engine, resell outputs without permission, or use the Service for unlawful purposes including market manipulation.</p>
<p><b style="color:#eef2f8">7. Limitation of liability.</b> To the maximum extent permitted by law, we are not liable for any trading losses, indirect, incidental, or consequential damages, or for decisions made using the Service. Our total liability is limited to the amount you paid in the 30 days before the claim.</p>
<p><b style="color:#eef2f8">8. Changes.</b> We may update these Terms; material changes re-prompt for consent. Continued use after changes means acceptance.</p>
<p><b style="color:#eef2f8">9. Termination.</b> We may suspend or terminate access for breach of these Terms or legal necessity.</p>
<p style="color:#5a6577;font-size:12px">Contact: @Bashmaz on Telegram.</p>
`;
const PRIVACY_HTML = `
<h3 style="color:#eef2f8">WAR Arena â€” Privacy Policy</h3>
<p style="color:#5a6577;font-family:monospace;font-size:11px">Version ${LEGAL_VERSION}</p>
<p><b style="color:#eef2f8">1. What we collect.</b> (a) A Telegram identity provided by Telegram when you open the Mini App (a numeric user id, and optionally username/first name/language), transmitted as signed initData. (b) Your usage: scans, monitors, and analytics requests you make. (c) Payment records: transaction ids, rail (Stars/TON), amounts, and balance/entitlement history. We do not collect your Telegram password, contacts, or messages.</p>
<p><b style="color:#eef2f8">2. What we do NOT collect.</b> We do not take custody of your funds, private keys, or seed phrases. TON payments are signed in your own wallet. We never ask for a private key.</p>
<p><b style="color:#eef2f8">3. Third parties.</b> Token data comes from GMGN; opening the app and Stars payments involve Telegram; TON payments involve the TON blockchain (public and permanent by nature). Your use is also subject to their terms and privacy practices. We share only what is necessary to provide the Service (e.g. a token address to query GMGN).</p>
<p><b style="color:#eef2f8">4. Why we process it.</b> To authenticate you, deliver scans/monitoring, process payments and credit, prevent abuse, and comply with law. Legal bases where applicable: performance of contract and legitimate interest.</p>
<p><b style="color:#eef2f8">5. Retention.</b> We keep account, payment, and usage records as long as your account exists and as required for legal, tax, and anti-fraud purposes, then delete or anonymize them.</p>
<p><b style="color:#eef2f8">6. Your rights.</b> Subject to your jurisdiction (e.g. GDPR/CCPA), you may request access, correction, deletion, or export of your data, and withdraw consent. Requests: contact @Bashmaz on Telegram.</p>
<p><b style="color:#eef2f8">7. Security.</b> Secrets are never logged; initData signatures are verified; payments are idempotent. No system is perfectly secure â€” you use the Service at your own risk.</p>
<p><b style="color:#eef2f8">8. Children.</b> The Service is not for anyone under the legal age in their jurisdiction.</p>
<p><b style="color:#eef2f8">9. Changes.</b> Material changes re-prompt for consent.</p>
<p style="color:#5a6577;font-size:12px">Contact: @Bashmaz on Telegram.</p>
`;

function showLegal(which){
  document.getElementById("legal-title").textContent = which === "terms" ? "Terms of Service" : "Privacy Policy";
  document.getElementById("legal-body").innerHTML = which === "terms" ? TERMS_HTML : PRIVACY_HTML;
  document.getElementById("legal-overlay").style.display = "flex";
}
document.getElementById("legal-close").onclick = () => { document.getElementById("legal-overlay").style.display = "none"; };
document.getElementById("lnk-terms").onclick = () => showLegal("terms");
document.getElementById("lnk-privacy").onclick = () => showLegal("privacy");

const consentCheck = document.getElementById("consent-check");
const consentEnter = document.getElementById("consent-enter");
consentCheck.onchange = () => {
  consentEnter.disabled = !consentCheck.checked;
  consentEnter.style.opacity = consentCheck.checked ? "1" : ".5";
};
consentEnter.onclick = async () => {
  // Record consent on the BACKEND (durable, per-user) â€” this is what unlocks
  // scan / watch / monitor. Without it the server returns 409 needsConsent.
  consentEnter.disabled = true;
  consentEnter.textContent = "Recordingâ€¦";
  const ok = await recordConsentRemote();
  if (ok) {
    document.getElementById("consent-gate").style.display = "none";
  } else {
    // Even if the network call fails, don't trap the user â€” hide the gate but
    // the server may re-prompt; the API layer also records consent lazily.
    consentEnter.disabled = false;
    consentEnter.textContent = "Enter WAR Arena";
    safeAlert("Could not reach the server to record consent. Check your connection and try again.");
  }
};

// POST the agreement to /consent so the backend unlocks protected features.
async function recordConsentRemote(){
  try {
    const r = await api("/consent", { method:"POST", body: JSON.stringify({ version: LEGAL_VERSION, source: "miniapp" }) });
    return !!(r && r.ok && r.isCurrent);
  } catch(e){ return false; }
}
// If terms version is unchanged and already agreed this session, we still show
// the gate each cold start of the Mini App (Telegram has no durable local store
// we rely on here); a live server records durable consent per user id.

// ---- Telegram SDK (graceful if opened outside Telegram) ----
const TG = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
if (TG) { TG.ready(); TG.expand(); }
const INIT_DATA = TG ? TG.initData : ""; // signed; sent to API for auth
// Safe popups: on older Telegram WebApp (v6.0), showAlert/showConfirm exist but
// throw WebAppMethodUnsupported. Wrap in try/catch and fall back to native.
function safeAlert(msg){
  try { if(TG && TG.showAlert){ TG.showAlert(msg); return; } } catch(e){}
  try { alert(msg); } catch(e){}
}
function safeConfirm(msg, cb){
  try { if(TG && TG.showConfirm){ TG.showConfirm(msg, cb); return; } } catch(e){}
  try { cb(confirm(msg)); } catch(e){ cb(false); }
}

// ---- API base: set this to your deployed server. Empty = demo/offline. ----
const API_BASE = (function(){
  // Auto-detect: when opened locally (localhost/127.0.0.1) talk to the local
  // server on :8080. Otherwise (deployed) use the configured server URL below.
  var DEPLOYED = "https://war-arena.onrender.com"; // live WAR backend on Render
  try {
    var h = location.hostname;
    if (h === "localhost" || h === "127.0.0.1" || h === "") return "http://localhost:8080";
  } catch(e){}
  return DEPLOYED;
})();

async function api(path, opts={}) {
  if (!API_BASE) return { ok:false, error:"API_NOT_CONFIGURED", status:0 };
  try {
    const res = await fetch(API_BASE+path, {
      ...opts,
      headers: { "content-type":"application/json", "x-telegram-init-data": INIT_DATA, ...(opts.headers||{}) },
    });
    let body = {};
    try { body = await res.json(); } catch(e){ body = {}; }
    // Surface the HTTP status so callers can branch on 402/403/409/429.
    return { status: res.status, ...body };
  } catch(e){ return { ok:false, error:String(e), status:0 }; }
}

