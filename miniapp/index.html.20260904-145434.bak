// ---- SCAN ----
let SELECTED_CHAIN = "sol";
// Chain is auto-detected from the pasted address (no manual buttons).
(function wireScanDetect(){
  const inp = document.getElementById("tokenInput");
  const ind = document.getElementById("chainDetected");
  if(!inp) return;
  inp.addEventListener("input", ()=>{
    const det = detectAddress(inp.value);
    if(!inp.value.trim()){ if(ind){ind.textContent="Paste an address â€” chain is detected automatically"; ind.className="chain-detected";} return; }
    if(det.family==="sol"){ SELECTED_CHAIN="sol"; if(ind){ind.textContent="â—Ž Solana detected"; ind.className="chain-detected ok";} }
    else if(det.family==="evm"){ SELECTED_CHAIN="eth"; if(ind){ind.textContent="â—Ž EVM detected â€” will check ETH Â· BSC Â· BASE"; ind.className="chain-detected ok";} }
    else { if(ind){ind.textContent="Unrecognised address format"; ind.className="chain-detected bad";} }
  });
})();
document.getElementById("scanBtn").onclick = ()=>doScan(document.getElementById("tokenInput").value.trim());

// ---- Live token search (uses /search â€” searches stored tokens by name/addr) ----
let SEARCH_TIMER = null;
(function wireSearch(){
  const inp = document.getElementById("tokenInput");
  const box = document.getElementById("searchResults");
  if(!inp || !box) return;
  inp.addEventListener("input", ()=>{
    const q = inp.value.trim();
    clearTimeout(SEARCH_TIMER);
    // Full address â†’ resolve it live (token or wallet, any chain).
    const looksAddr = (q.startsWith("0x") && q.length===42) || (!q.startsWith("0x") && q.length>=32 && !q.includes(" "));
    if(looksAddr){ SEARCH_TIMER = setTimeout(()=>resolveAddress(q), 350); return; }
    if(q.length < 2){ box.classList.remove("open"); box.innerHTML=""; return; }
    SEARCH_TIMER = setTimeout(()=>runSearch(q), 280);
  });
  // hide results when tapping elsewhere
  document.addEventListener("click", (e)=>{
    if(!box.contains(e.target) && e.target !== inp){ box.classList.remove("open"); }
  });
})();

async function resolveAddress(address){
  const box = document.getElementById("searchResults");
  if(!box) return;
  box.innerHTML = "<div class='sr-empty'>â— Resolving address across chainsâ€¦</div>";
  box.classList.add("open");
  const r = await api("/resolve?address=" + encodeURIComponent(address));
  if(!r || !r.ok){ box.innerHTML = "<div class='sr-empty'>Could not resolve this address.</div>"; return; }

  if(r.kind === "token"){
    const sym = r.symbol ? "$"+r.symbol : "Token";
    const price = r.priceUsd!=null ? " Â· $"+Number(r.priceUsd).toPrecision(3) : "";
    box.innerHTML = "<div class='sr-item' id='sr-resolved'>"
      + "<div><div class='sr-sym'>"+sym+" <span style='color:var(--faint);font-size:9px'>TOKEN</span></div>"
      + "<div class='sr-addr'>"+(r.chain||"").toUpperCase()+price+"</div></div>"
      + "<div class='sr-chain'>SCAN &rarr;</div></div>";
    document.getElementById("sr-resolved").onclick = ()=>{
      SELECTED_CHAIN = r.chain || SELECTED_CHAIN;
      document.getElementById("tokenInput").value = r.address;
      box.classList.remove("open");
      doScan(r.address);
    };
  } else if(r.kind === "wallet"){
    const rep = r.reputation;
    const verdict = rep ? rep.verdict : "WALLET";
    const wr = (rep && rep.winRate!=null) ? " Â· "+Math.round(rep.winRate*100)+"% win" : "";
    box.innerHTML = "<div class='sr-item' id='sr-resolved'>"
      + "<div><div class='sr-sym'>"+verdict+" <span style='color:var(--faint);font-size:9px'>WALLET</span></div>"
      + "<div class='sr-addr'>"+(r.chain||"").toUpperCase()+wr+"</div></div>"
      + "<div class='sr-chain'>&#9673; WATCH</div></div>";
    document.getElementById("sr-resolved").onclick = ()=>{
      box.classList.remove("open");
      intelFollow(r.chain, r.address);
    };
  } else {
    box.innerHTML = "<div class='sr-empty'>Address not recognised as a token or active wallet.</div>";
  }
}

async function runSearch(q){
  const box = document.getElementById("searchResults");
  if(!box) return;
  const r = await api("/search?q=" + encodeURIComponent(q));
  const results = (r && r.ok && Array.isArray(r.data)) ? r.data
    : (Array.isArray(r) ? r : (r && Array.isArray(r.results) ? r.results : []));
  if(!results.length){
    box.innerHTML = "<div class='sr-empty'>No tokens found for \""+q+"\" yet â€” try pasting the address.</div>";
    box.classList.add("open"); return;
  }
  box.innerHTML = results.slice(0,8).map(t=>{
    const sym = t.symbol ? "$"+t.symbol : "token";
    const short = t.address && t.address.length>14 ? t.address.slice(0,6)+"â€¦"+t.address.slice(-5) : (t.address||"");
    return "<div class='sr-item' data-addr='"+encodeURIComponent(t.address||"")+"' data-chain='"+(t.chain||"")+"'>"
      + "<div><div class='sr-sym'>"+sym+"</div><div class='sr-addr'>"+short+"</div></div>"
      + "<div class='sr-chain'>"+(t.chain||"").toUpperCase()+"</div></div>";
  }).join("");
  box.classList.add("open");
  box.querySelectorAll(".sr-item").forEach(el=>{
    el.onclick = ()=>{
      const addr = decodeURIComponent(el.getAttribute("data-addr")||"");
      const chain = el.getAttribute("data-chain")||"";
      if(chain){ SELECTED_CHAIN = chain; }
      document.getElementById("tokenInput").value = addr;
      box.classList.remove("open");
      try { if(TG && TG.HapticFeedback) TG.HapticFeedback.selectionChanged(); } catch(e){}
    };
  });
}
async function doScan(addr){
  // Live path: if the API is configured, go through the server so the
  // promotion / daily-limit / membership rules actually apply.
  if(API_BASE){
    const fallback = SELECTED_CHAIN==="sol" ? "So11111111111111111111111111111111111111112" : "";
    const token = { chain: SELECTED_CHAIN, address: addr || fallback };
    if(!token.address){ document.getElementById("scanResult").innerHTML="<div class='card lock'><div class='big'>âœï¸</div><div>Enter a token address</div></div>"; return; }
    const res = await api("/scan", { method:"POST", body: JSON.stringify({ token }) });
    if(res.ok){ syncWallet(); return; } // renderScan from live payload handled server-side
    const status = res.status || 0;
    if(status===403 || res.error==="channel membership required"){ showMemberGate(res.joinChannel); return; }
    if(status===429 || (res.error||"").indexOf("daily")>=0){ showDailyLimit(res.retryAtMs); return; }
    if(status===402 || res.needsTopUp){ showPaywall(); return; }
    if(status===409 || res.needsConsent){ document.getElementById("consent-gate").style.display="flex"; return; }
    document.getElementById("scanResult").innerHTML = "<div class='card lock'><div class='big'>âš ï¸</div><div>Scan unavailable</div><div class='muted' style='margin-top:8px'>"+(res.error||"Please try again.")+"</div></div>";
    return;
  }
  // Fallback path (no API): only if we actually have loaded tokens.
  if(!DEMO.worlds || !DEMO.worlds.length){ safeAlert("Live tokens are still loading â€” try again in a moment."); return; }
  if(!addr){ renderScan(DEMO.worlds[0], true); return; }
  const found = DEMO.worlds.find(w=>w.address && w.address.startsWith(addr.slice(0,4))) || DEMO.worlds[0];
  renderScan(found, true);
}
// ---- statistics helpers (confirmed GMGN fields + derived composites) ----
function fmtUsd(n){ if(n==null)return "â€”"; const a=Math.abs(n);
  if(a>=1e9)return "$"+(n/1e9).toFixed(2)+"B"; if(a>=1e6)return "$"+(n/1e6).toFixed(2)+"M";
  if(a>=1e3)return "$"+(n/1e3).toFixed(1)+"K"; if(a>0&&a<1)return "$"+n.toPrecision(2); return "$"+Math.round(n).toLocaleString(); }
function pct(n){ return n==null?"â€”":(Math.round(n*1000)/10)+"%"; }
function num(n){ return n==null?"â€”":Math.round(n).toLocaleString(); }

// Derived: composite SAFETY score (0-100) from confirmed risk fields.
// Higher = safer. Transparent formula (no hidden magic): starts at 100, subtracts
// weighted penalties for rug ratio, top-10 concentration, wash trading.
function safetyScore(s){
  if(!s) return null;
  let score=100; const notes=[];
  if(typeof s.rugRatio==="number"){ score-=s.rugRatio*55; if(s.rugRatio>0.3)notes.push("elevated rug ratio"); }
  if(typeof s.top10Rate==="number"){ const over=Math.max(0,s.top10Rate-0.2); score-=over*70; if(s.top10Rate>0.5)notes.push("top-10 hold a large share"); }
  if(s.washTrading===true){ score-=25; notes.push("wash trading detected"); }
  score=Math.max(0,Math.min(100,Math.round(score)));
  const band = score>=75?"SAFE":score>=50?"CAUTION":"HIGH RISK";
  const col = score>=75?"var(--green)":score>=50?"var(--gold)":"var(--threat)";
  return { score, band, col, notes };
}
// Derived: liquidity health = liquidity / marketCap (deeper pool vs cap = healthier)
function liqHealth(s){ if(!s||!s.marketCap||!s.liquidity)return null;
  const r=s.liquidity/s.marketCap; const band=r>=0.15?"DEEP":r>=0.05?"MODERATE":"THIN";
  const col=r>=0.15?"var(--green)":r>=0.05?"var(--gold)":"var(--threat)"; return {r,band,col}; }
// Derived: buy/sell pressure from confirmed buys/sells counts
function buySellPressure(s){ if(!s||(s.buys==null&&s.sells==null))return null;
  const b=s.buys||0,se=s.sells||0,tot=b+se; if(!tot)return null;
  const ratio=b/tot; const col=ratio>=0.6?"var(--green)":ratio>=0.4?"var(--gold)":"var(--threat)";
  return {ratio,b,se,col}; }

// ============ WAR ANALYSIS â€” signature engine section ============
// Renders the derived intelligence indices produced by the WAR engine. Each
// index shows its score, band, value and the exact formula behind it.
const BAND_COL = { STRONG:"var(--green)", GOOD:"#7fd4b0", NEUTRAL:"var(--gold)", WEAK:"#ff9d6c", CRITICAL:"var(--threat)", INSUFFICIENT:"var(--faint)" };
// WAR SIGNATURE â€” classify the CURRENT structure from the 9 indices.
// Pure, deterministic, derived only from computed index scores. This is
// classification of the present, NOT a prediction of the future.
function warSignature(indices){
  const by = {}; indices.forEach(ix=>{ if(ix.score!=null) by[ix.key]=ix.score; });
  const g = (k)=> (k in by) ? by[k] : null;   // higher = better for forces
  const tags = [];
  // strengths
  if(g("conviction")!=null && g("conviction")>=65 && g("organic")!=null && g("organic")>=70) tags.push("HIGH-CONVICTION");
  if(g("organic")!=null && g("organic")>=70) tags.push("ORGANIC");
  if(g("absorption")!=null && g("absorption")>=70) tags.push("DEEP-ABSORPTION");
  if(g("integrity")!=null && g("integrity")>=85) tags.push("CLEAN-STRUCTURE");
  // risks (these indices: higher score = more risk, so read raw)
  if(g("snipers")!=null && g("snipers")>=60) tags.push("SNIPER-HEAVY");
  if(g("concentration")!=null && g("concentration")>=50) tags.push("CONCENTRATED");
  if(g("turnover")!=null && g("turnover")>=70) tags.push("HIGH-TURNOVER");
  // low-signal fallback
  if(!tags.length){
    if(g("organic")!=null && g("organic")<40) tags.push("LOW-CONVICTION");
    else tags.push("MIXED-STRUCTURE");
  }
  return tags.slice(0,4);
}

function warAnalysisCard(w){
  const a = w.analysis;
  if(!a || !a.indices) return "";
  const v = a.verdict || {};
  const col = BAND_COL[v.band] || "var(--sub)";
  const scoreTxt = (v.score==null) ? "â€”" : v.score;

  // --- signal coverage: how many indices actually contributed ---
  const contribN = a.indices.filter(ix=>ix.score!=null).length;
  const totalN = a.indices.length;
  const partial = contribN < totalN;

  // circular gauge
  const R=34, C=2*Math.PI*R, sc=(v.score==null?0:v.score);
  const dash=(sc/100)*C;
  const gauge =
    "<div class='wgauge'>"+
      "<svg viewBox='0 0 80 80' width='80' height='80'>"+
        "<circle cx='40' cy='40' r='"+R+"' fill='none' stroke='rgba(255,255,255,.07)' stroke-width='7'/>"+
        "<circle cx='40' cy='40' r='"+R+"' fill='none' stroke='"+col+"' stroke-width='7' stroke-linecap='round' "+
          "stroke-dasharray='"+dash+" "+C+"' transform='rotate(-90 40 40)' class='wgring'/>"+
      "</svg>"+
      "<div class='wgcenter'><div class='wgnum' style='color:"+col+"'>"+scoreTxt+"</div><div class='wglab'>/100</div></div>"+
    "</div>";

  // --- headline: gauge + band + SIGNATURE (the hero, not just the number) ---
  const sig = warSignature(a.indices);
  const sigChips = sig.map(t=>"<span class='sigchip'>"+t+"</span>").join("");
  let html = "<div class='glass sc warcard'>"+
    "<div class='eyebrow'>WAR Analysis Â· reads token structure Â· not a prediction</div>"+
    "<div class='wartop'>"+
      gauge+
      "<div class='warverd'><div class='wsband' style='color:"+col+"'>"+(v.band||"â€”")+"</div>"+
        "<div class='wslab2'>WAR SCORE Â· <span class='"+(partial?"covpartial":"covfull")+"'>"+contribN+"/"+totalN+" signal</span></div>"+
        "<div class='wsig'>"+sigChips+"</div></div>"+
    "</div>";

  // --- token identity: symbol + full contract address, right under the headline ---
  // The address copies the FULL contract (w.fullAddress when present, else w.address),
  // never the shortened display form — a truncated address is useless when pasted.
  const fullAddr = w.fullAddress || w.address || "";
  if(w.sym || fullAddr){
    html += "<div class='wtoken'>"+
      (w.sym ? "<span class='wtoken-sym'>"+w.sym+"</span>" : "")+
      (w.chain ? "<span class='wtoken-chain'>"+String(w.chain).toUpperCase()+"</span>" : "")+
      (fullAddr ? "<span class='wtoken-addr' data-copy='"+encodeURIComponent(fullAddr)+"' title='Tap to copy full address'>"+fullAddr+" &#10697;</span>" : "")+
      "</div>";
  }

  // Prominent rug-ratio warning: GMGN's rug_ratio is shown RAW next to the WAR
  // score, not folded into it. High values on very new tokens can be noisy, so
  // we surface the signal and let the user judge rather than silently capping.
  const rr = (w.stats && typeof w.stats.rugRatio === "number") ? w.stats.rugRatio : null;
  if(rr != null && rr > 0.5){
    html += "<div class='rugwarn'>WARNING - GMGN RUG RATIO: "+Math.round(rr*100)+"% - high rug-pattern signal. Verify the contract yourself before any position.</div>";
  }

  if(partial){
    html += "<div class='partialbar'>â— PARTIAL SIGNAL â€” "+(totalN-contribN)+" indices lack confirmed data and are excluded, not assumed.</div>";
  }

  // --- WHY WAR? â€” the ranked findings, split into + strengths and âˆ’ risks ---
  // Each index is a force (higherIsBetter) or a threat. A "good" reading is a +,
  // a "bad" one is a âˆ’. This turns the raw findings into a readable rationale.
  const pos=[], neg=[];
  a.indices.forEach(ix=>{
    if(ix.score==null) return;
    // A capping index (e.g. live rug authority) is ALWAYS a risk, even if its
    // raw sub-score is high â€” never show "mint authority live" as a strength.
    const good = ix.capsScoreAt != null ? false
      : ix.higherIsBetter ? ix.score>=60 : ix.score<40; // low risk = good
    (good?pos:neg).push({label:ix.label, reading:ix.reading});
  });
  const whyRow = (arr,sign,cls)=> arr.map(x=>
    "<div class='whyrow "+cls+"'><span class='whysign'>"+sign+"</span><span class='whylab'>"+x.label+"</span><span class='whyread'>"+x.reading+"</span></div>"
  ).join("");
  if(pos.length||neg.length){
    html += "<div class='eyebrow' style='margin-top:16px'>Why WAR reads it this way</div><div class='whybox'>";
    html += whyRow(pos.slice(0,4),"+","pos");
    html += whyRow(neg.slice(0,4),"âˆ’","neg");
    html += "</div>";
  }

  // --- MARKET CONTEXT â€” live price + flow, a present-moment read (not a forecast) ---
  const st = w.stats||{};
  const c5 = st.change5m, c1 = st.change1h;
  const buys = st.buys, sells = st.sells;
  const hasCtx = (c5!=null)||(c1!=null)||(buys!=null&&sells!=null);
  if(hasCtx){
    const pctCol=x=> x==null?"var(--faint)":(x>=0?"var(--green)":"var(--threat)");
    const pctTxt=x=> x==null?"â€”":((x>=0?"+":"")+x.toFixed(1)+"%");
    let flowTxt="â€”", flowCol="var(--faint)";
    if(buys!=null&&sells!=null&&(buys+sells)>0){
      const bs=buys/(buys+sells);
      flowTxt=Math.round(bs*100)+"% BUY";
      flowCol=bs>=0.5?"var(--green)":"var(--threat)";
    }
    html += "<div class='eyebrow' style='margin-top:16px'>Market context Â· now</div>"+
      "<div class='ctxgrid'>"+
        "<div class='ctxcell'><div class='ctxk'>5M</div><div class='ctxv' style='color:"+pctCol(c5)+"'>"+pctTxt(c5)+"</div></div>"+
        "<div class='ctxcell'><div class='ctxk'>1H</div><div class='ctxv' style='color:"+pctCol(c1)+"'>"+pctTxt(c1)+"</div></div>"+
        "<div class='ctxcell'><div class='ctxk'>FLOW</div><div class='ctxv' style='color:"+flowCol+"'>"+flowTxt+"</div></div>"+
      "</div>";
  }

  // --- FORCES vs THREATS â€” the 9 indices split into two readable columns ---
  const forces = a.indices.filter(ix=>ix.higherIsBetter);
  const threats = a.indices.filter(ix=>!ix.higherIsBetter);
  const idxRow = (ix)=>{
    const c = BAND_COL[ix.band] || "var(--sub)";
    const bar = ix.score==null ? 0 : (ix.higherIsBetter ? ix.score : 100-ix.score);
    return "<div class='wrow' onclick=\"this.classList.toggle('open')\">"+
      "<div class='wrhead'>"+
        "<div class='wrlab'>"+ix.label+"</div>"+
        "<div class='wrval' style='color:"+c+"'>"+(ix.score==null?"â€”":ix.score)+"<span class='wrband'>"+ix.band+"</span></div>"+
      "</div>"+
      "<div class='wrtrk'><div class='wrfill' style='width:"+bar+"%;background:"+c+"'></div></div>"+
      "<div class='wrmeta'>"+ix.display+"</div>"+
      "<div class='wrdet'><div class='wrread'>"+ix.reading+"</div>"+
        "<div class='wrform'><b>Formula:</b> "+ix.formula+"</div></div>"+
      "</div>";
  };
  html += "<div class='eyebrow forcehead' style='margin-top:16px'>â—¤ WAR Forces</div><div class='widx'>"+
    forces.map(idxRow).join("")+"</div>";
  html += "<div class='eyebrow threathead' style='margin-top:14px'>â—¢ WAR Threats</div><div class='widx'>"+
    threats.map(idxRow).join("")+"</div>";

  if(Array.isArray(v.excluded) && v.excluded.length){
    html += "<div class='disc'>Excluded from the score (insufficient data): "+v.excluded.join(", ")+". Missing inputs are never assumed â€” they are left out and the weights renormalised.</div>";
  } else {
    html += "<div class='disc'>All indices are deterministic functions of confirmed on-chain metrics. Tap any index for its formula. WAR reads structure â€” this is analysis, not financial advice.</div>";
  }
  return html + "</div>";
}

function statsCard(w){
  const s=w.stats;
  if(!s){
    return "<div class='glass sc'><div class='eyebrow'>Token statistics</div><div class='empty'>Statistics not available for this token yet.</div></div>";
  }
  const tile=(label,val,col)=>"<div class='stile'><div class='sklab'>"+label+"</div><div class='skval'"+(col?" style='color:"+col+"'":"")+">"+val+"</div></div>";
  const yn=(v,goodWhenTrue)=>{const g=goodWhenTrue?v:!v;return "<b style='color:"+(g?"var(--green)":"var(--threat)")+"'>"+(v?"YES":"NO")+"</b>";};
  const ageOf=ts=>{ if(!ts)return "â€”"; const sec=Math.floor(Date.now()/1000)-ts; if(sec<3600)return Math.floor(sec/60)+"m"; if(sec<86400)return Math.floor(sec/3600)+"h"; return Math.floor(sec/86400)+"d"; };

  // ---- OVERVIEW ----
  let html = "<div class='glass sc'><div class='eyebrow'>Overview</div><div class='sgrid'>"+
    tile("PRICE", s.priceUsd!=null?fmtUsd(s.priceUsd):"â€”")+
    tile("MARKET CAP", fmtUsd(s.marketCap))+
    tile("ATH MC", fmtUsd(s.athMarketCap))+
    tile("LIQUIDITY", fmtUsd(s.liquidity))+
    tile("24H VOLUME", fmtUsd(s.volume))+
    tile("HOLDERS", num(s.holders))+
    "</div>";
  // price changes row
  const chg=(v)=>v==null?"â€”":"<b style='color:"+(v>=0?"var(--green)":"var(--threat)")+"'>"+(v>=0?"+":"")+Math.round(v)+"%</b>";
  html += "<div class='sderiv' style='margin-top:12px'>"+
    "<div class='dtile'><span>Price change</span><span>1m "+chg(s.change1m)+" Â· 5m "+chg(s.change5m)+" Â· 1h "+chg(s.change1h)+"</span></div>"+
    "<div class='dtile'><span>Token age</span><b>"+ageOf(s.creationTs)+"</b></div>"+
    (s.launchpad?"<div class='dtile'><span>Launchpad</span><b>"+s.launchpad+"</b></div>":"")+
    (s.exchange?"<div class='dtile'><span>Exchange</span><b>"+s.exchange+"</b></div>":"")+
    "</div></div>";

  // ---- SAFETY ----
  const safe=safetyScore(s);
  html += "<div class='glass sc'><div class='eyebrow'>Safety assessment Â· derived</div>";
  if(safe){
    html += "<div class='safebar'><div class='safefill' style='width:"+safe.score+"%;background:"+safe.col+"'></div></div>"+
      "<div class='saferow'><span class='qpill' style='color:"+safe.col+";border-color:"+safe.col+"66'>"+safe.band+" Â· "+safe.score+"/100</span>"+
      (safe.notes.length?"<span class='safenote'>"+safe.notes.join(" Â· ")+"</span>":"<span class='safenote' style='color:var(--green)'>no major flags</span>")+"</div>";
  }
  html += "<div class='sderiv'>"+
    "<div class='dtile'><span>Honeypot</span>"+yn(s.honeypot,false)+"</div>"+
    "<div class='dtile'><span>Contract renounced</span>"+yn(s.renounced,true)+"</div>"+
    "<div class='dtile'><span>Open source</span>"+yn(s.openSource,true)+"</div>"+
    "<div class='dtile'><span>Mint renounced</span>"+yn(s.renouncedMint,true)+"</div>"+
    "<div class='dtile'><span>Freeze renounced</span>"+yn(s.renouncedFreeze,true)+"</div>"+
    (s.lockPercent!=null?"<div class='dtile'><span>Liquidity locked</span><b>"+pct(s.lockPercent)+"</b></div>":"")+
    (s.burnStatus?"<div class='dtile'><span>LP burn</span><b>"+s.burnStatus+(s.burnRatio?" ("+pct(s.burnRatio)+")":"")+"</b></div>":"")+
    "<div class='dtile'><span>Rug ratio</span><b style='color:"+((s.rugRatio||0)>0.3?"var(--threat)":(s.rugRatio||0)>0.1?"var(--gold)":"var(--green)")+"'>"+pct(s.rugRatio)+"</b></div>"+
    "<div class='dtile'><span>Wash trading</span><b style='color:"+(s.washTrading?"var(--threat)":"var(--green)")+"'>"+(s.washTrading?"DETECTED":"none")+"</b></div>"+
    (s.buyTax||s.sellTax?"<div class='dtile'><span>Tax (buy/sell)</span><b>"+(s.buyTax||"0")+" / "+(s.sellTax||"0")+"</b></div>":"")+
    "</div>";
  html += "<div class='disc'>Safety score is a derived composite of confirmed on-chain risk fields. Not financial advice â€” always verify independently.</div></div>";

  // ---- HOLDERS & TRADERS ----
  const lh=liqHealth(s), bsp=buySellPressure(s);
  html += "<div class='glass sc'><div class='eyebrow'>Holders & traders</div><div class='sderiv'>"+
    "<div class='dtile'><span>Top 10 hold</span><b style='color:"+((s.top10Rate||0)>0.5?"var(--threat)":(s.top10Rate||0)>0.3?"var(--gold)":"var(--green)")+"'>"+pct(s.top10Rate)+"</b></div>"+
    (s.bluechipPct!=null?"<div class='dtile'><span>Bluechip holders</span><b>"+pct(s.bluechipPct)+"</b></div>":"")+
    (s.devHoldRate!=null?"<div class='dtile'><span>Dev holding</span><b style='color:"+((s.devHoldRate||0)>0.1?"var(--gold)":"var(--green)")+"'>"+pct(s.devHoldRate)+"</b></div>":"")+
    "<div class='dtile'><span>Smart money</span><b style='color:var(--green)'>"+num(s.smartMoney)+" wallets</b></div>"+
    "<div class='dtile'><span>Renowned traders</span><b>"+num(s.renowned)+"</b></div>"+
    (s.sniperCount!=null?"<div class='dtile'><span>Snipers</span><b style='color:"+((s.sniperCount||0)>30?"var(--gold)":"var(--sub)")+"'>"+num(s.sniperCount)+"</b></div>":"")+
    (s.top70SniperRate!=null&&s.top70SniperRate>0?"<div class='dtile'><span>Top-70 sniper hold</span><b>"+pct(s.top70SniperRate)+"</b></div>":"")+
    (s.botRate!=null?"<div class='dtile'><span>Bot activity</span><b style='color:"+((s.botRate||0)>0.5?"var(--threat)":(s.botRate||0)>0.3?"var(--gold)":"var(--sub)")+"'>"+pct(s.botRate)+"</b></div>":"")+
    (bsp?"<div class='dtile'><span>Buy/sell pressure</span><b style='color:"+bsp.col+"'>"+pct(bsp.ratio)+" buys ("+bsp.b+"/"+bsp.se+")</b></div>":"")+
    (lh?"<div class='dtile'><span>Liquidity depth</span><b style='color:"+lh.col+"'>"+lh.band+"</b></div>":"")+
    "</div></div>";

  // ---- LINKS / SOURCE ----
  const links=[];
  if(s.twitter) links.push("<a class='slink' href='"+s.twitter+"' target='_blank' rel='noopener'>Twitter</a>");
  if(s.website) links.push("<a class='slink' href='"+s.website+"' target='_blank' rel='noopener'>Website</a>");
  if(s.telegram) links.push("<a class='slink' href='"+s.telegram+"' target='_blank' rel='noopener'>Telegram</a>");
  if(links.length || s.creator){
    html += "<div class='glass sc'><div class='eyebrow'>Source</div><div class='sderiv'>"+
      (s.creator?"<div class='dtile'><span>Creator</span><b class='mono' data-copy='"+encodeURIComponent(s.creator)+"' title='Tap to copy'>"+s.creator.slice(0,4)+"â€¦"+s.creator.slice(-4)+"</b></div>":"")+
      (s.creatorStatus?"<div class='dtile'><span>Creator status</span><b>"+s.creatorStatus.replace(/_/g,' ')+"</b></div>":"")+
      "</div>"+
      (links.length?"<div class='slinks'>"+links.join("")+"</div>":"")+
      "</div>";
  }

  return html;
}

function renderScan(w, charge){
  // charge model: free first, else balance; honest UI
  if(charge){
    if(ACCT.freeScansRemaining>0){ ACCT.freeScansRemaining--; }
    else if(ACCT.balanceUsd>=0.1){ ACCT.balanceUsd = Math.round((ACCT.balanceUsd-0.1)*100)/100; }
    else { showPaywall(); return; }
    syncWallet();
  }
  const c=MOOD_HEX[w.mood]||"#93a0b5", q=QUAL_HEX[w.dataQuality]||"#93a0b5";
  const L=liqOf(w);
  const laneLabel={SMART_MONEY:"SMART MONEY",KOL:"KOL",FOLLOW_WALLET:"FOLLOW",OTHER:"OTHER"};
  const laneColor={SMART_MONEY:"var(--sig)",KOL:"var(--gold)",FOLLOW_WALLET:"var(--cmd)",OTHER:"var(--faint)"};

  // --- state row (mood + trajectory + coherence + leadLag + regime) ---
  const chips=[["STATE",w.mood,c],["TRAJECTORY",w.trajectory,"var(--sub)"],["COHERENCE",w.coherence,"var(--sub)"],["LEAD/LAG",w.leadLag,"var(--sub)"],["REGIME",w.regime,"var(--faint)"]]
    .map(([k,v,col])=>"<div class='sbadge'><div class='sk'>"+k+"</div><div class='sv' style='color:"+col+"'>"+v+"</div></div>").join("");

  // --- forces (raw + band) ---
  const F=(label,f,col)=>"<div class='f'><div class='fl'>"+label+"</div><div class='ftrk'><div class='ffill' style='width:"+f.raw+"%;background:linear-gradient(90deg,"+col+"44,"+col+")'></div></div><div class='fv' style='color:"+col+"'>"+f.raw+"<span class='fband'>"+f.band+"</span></div></div>";
  const forces=F("POWER",w.power,"#5b8cff")+F("THREAT",w.threat,"#ff5d6c")+F("CONFIDENCE",w.confidence,"#4fd0a8")+F("ATTENTION",w.attention,"#f0b64d");

  // --- flow entities (lanes) ---
  // A flow row is either LIVE (real on-chain wallet the server sent) or SIMULATED
  // (illustrative, derived from aggregate stats â€” NOT a real wallet). We never
  // let the two blur: simulated rows carry an explicit SIM badge and the whole
  // section is relabelled when any row is simulated.
  const flowIsSim = !!(w.flow && w.flow.length && w.flow.some(f=>f.sim));
  const flowRows = w.flow&&w.flow.length ? w.flow.map(f=>
    "<div class='frow'><span class='fside "+(f.side)+"'>"+(f.side==="buy"?"â–²":"â–¼")+"</span>"+
    "<span class='fmaker'>"+f.maker+(f.sim?"<span class='simtag'>SIM</span>":"")+"</span>"+
    "<span class='flane' style='color:"+laneColor[f.lane]+";border-color:"+laneColor[f.lane]+"44'>"+laneLabel[f.lane]+"</span>"+
    "<span class='famt' style='color:"+(f.side==="buy"?"var(--sig)":"var(--threat)")+"'>"+usd0(f.amountUsd)+"</span></div>"
  ).join("") : "<div class='empty'>No flow in window</div>";
  const flowEyebrow = flowIsSim
    ? "<div class='eyebrow simhead'>Simulated flow Â· illustrative â€” not real on-chain wallets</div>"
    : "<div class='eyebrow'>Flow entities Â· by lane Â· <span style='color:var(--sig)'>LIVE</span></div>";

  // --- events ---
  const eventRows = w.events&&w.events.length ? w.events.map(e=>
    "<div class='erow'><div class='etype'>"+e.type.replace(/_/g,' ')+"<span class='eimp'>"+e.importance+"</span></div><div class='ereason'>"+e.reason+"</div></div>"
  ).join("") : "<div class='empty'>No notable events</div>";

  // --- signals (identity + phase) ---
  const sigRows = w.signals&&w.signals.length ? w.signals.map(s=>
    "<span class='sig'>"+s.identity+" <b>"+s.phase+"</b></span>"
  ).join("") : "<span class='empty'>No tracked signals</span>";

  // --- insufficient (epistemic honesty â€” always surfaced) ---
  const insufBlock = w.insufficient&&w.insufficient.length ?
    "<div class='glass insuf'><div class='eyebrow'>Insufficient data â€” surfaced, not guessed</div>"+
    w.insufficient.map(i=>"<span class='ins'>"+i.replace(/_/g,' ')+"</span>").join("")+"</div>" : "";

  document.getElementById("scanResult").innerHTML =
    // WAR ANALYSIS â€” signature engine section, first thing the user sees
    warAnalysisCard(w)+
    // header
    "<div class='glass sc'>"+
      "<div class='token'><div class='sym'>"+w.sym+"</div><div class='addr' data-copy='"+encodeURIComponent(w.address||"")+"' title='Tap to copy'>"+w.chain.toUpperCase()+" Â· "+w.address+"</div></div>"+
      "<div class='moodline' style='color:"+c+";text-shadow:0 0 14px "+c+"66'>â—¢ "+w.mood+"</div>"+
      "<div class='states'>"+chips+"</div>"+
    "</div>"+
    // liquidity
    "<div class='glass sc'><div class='eyebrow'>Liquidity flow</div>"+
      "<div class='liq'>"+
        "<div class='lcol in'><div class='llab' style='color:var(--sig)'>INFLOW Â· BUYS</div><div class='lval' style='color:var(--sig)'>"+usd0(L.inflow)+"</div><div class='lmeta'>"+L.buys+" buys</div></div>"+
        "<div class='lcol out'><div class='llab' style='color:var(--threat)'>OUTFLOW Â· SELLS</div><div class='lval' style='color:var(--threat)'>"+usd0(L.outflow)+"</div><div class='lmeta'>"+L.sells+" sells</div></div>"+
      "</div>"+
      "<div class='net'>NET FLOW <b style='color:"+(L.net>=0?"var(--sig)":"var(--threat)")+"'>"+(L.net>=0?"+":"âˆ’")+usd0(Math.abs(L.net))+"</b> Â· "+L.distinctMakers+" distinct makers</div>"+
    "</div>"+
    // forces
    "<div class='glass sc'><div class='eyebrow'>Force balance</div><div class='forces'>"+forces+"</div></div>"+
    statsCard(w)+
    // flow entities
    // Flow display policy â€” honesty first:
    //  â€¢ real wallets (sim=false)                â†’ show as LIVE
    //  â€¢ simulated wallets in explicit DEMO mode  â†’ show, clearly SIM-tagged
    //  â€¢ simulated wallets in LIVE-TOKENS mode    â†’ DO NOT show fake wallets;
    //    state plainly that per-wallet flow isn't available from the trending feed.
    ((flowIsSim && (typeof LIVE!=="undefined" ? LIVE.dataMode : "DEMO") !== "DEMO")
      ? "<div class='glass sc'><div class='eyebrow'>Flow entities Â· by lane</div>"+
        "<div class='flowunavail'>â—Œ FLOW DATA UNAVAILABLE<div class='fusub'>Per-wallet flow isn't exposed by the trending feed. Run a full scan for wallet-level data.</div></div></div>"
      : "<div class='glass sc"+(flowIsSim?" simcard":"")+"'>"+flowEyebrow+"<div class='flowlist'>"+flowRows+"</div></div>")+
    // events + signals
    "<div class='glass sc'><div class='eyebrow'>Events</div><div class='events'>"+eventRows+"</div>"+
      "<div class='eyebrow' style='margin-top:16px'>Tracked signals</div><div class='sigs'>"+sigRows+"</div></div>"+
    // why now
    "<div class='glass sc'><div class='eyebrow'>Why now</div>"+
      w.whyNow.map(s=>"<div class='why'>â–¸ "+s+"</div>").join("")+"</div>"+
    // data quality
    "<div class='glass sc'><div class='eyebrow'>Data quality</div>"+
      "<span class='qpill' style='color:"+q+";border-color:"+q+"66'>"+w.dataQuality+"</span>"+
      (w.qualityReasons&&w.qualityReasons.length?"<div class='qreasons'>"+w.qualityReasons.map(r=>"<div>Â· "+r+"</div>").join("")+"</div>":"")+
      "<button class='cta gold' style='margin-top:16px' onclick='startMonitor(\""+w.sym+"\")'>Monitor 24h Â· $1.00</button></div>"+
    // insufficient (honest)
    insufBlock;

  // switch to scan screen
  document.querySelectorAll(".nav button").forEach(x=>x.classList.remove("on"));
  document.querySelector('.nav button[data-s="scan"]').classList.add("on");
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("on"));
  document.getElementById("s-scan").classList.add("on"); document.body.setAttribute("data-screen","scan");
  window.scrollTo(0,0);
}
function showPaywall(){
  document.getElementById("scanResult").innerHTML =
    "<div class='card lock'><div class='big'>ðŸ”’</div><div>Your free scans are used up</div>"+
    "<div class='muted' style='margin:8px 0 14px'>Top up to continue â€” $0.10 per scan</div>"+
    "<button class='btn gold' onclick='goAccount()'>Top up balance</button></div>";
}

// ---- daily usage limit (429) ----
function showDailyLimit(retryAtMs){
  let when = "tomorrow";
  if(retryAtMs){ try{ when = new Date(retryAtMs).toLocaleString(undefined,{hour:"2-digit",minute:"2-digit",day:"numeric",month:"short"}); }catch(e){} }
  document.getElementById("scanResult").innerHTML =
    "<div class='card lock'><div class='big'>â³</div><div>Daily limit reached</div>"+
    "<div class='muted' style='margin:8px 0 4px'>You've used all your scans for today.</div>"+
    "<div class='muted' style='margin:0 0 14px'>Try again after "+when+".</div>"+
    "<button class='btn gold' onclick='goAccount()'>Top up credit to continue scanning</button></div>";
}

// ---- membership gate (403) ----
function showMemberGate(channel){
  const ov = document.getElementById("member-overlay");
  const join = document.getElementById("member-join");
  const handle = (channel||"").replace(/^@/,"");
  join.href = handle ? ("https://t.me/"+handle) : "#";
  ov.style.display = "flex";
}
document.getElementById("member-close").onclick = ()=>{ document.getElementById("member-overlay").style.display="none"; };
document.getElementById("member-recheck").onclick = async ()=>{
  // re-pull /me; if the server now lets a scan through, the gate will clear on next scan
  const me = await api("/me");
  if(me.ok && me.membership) LIVE.membership = me.membership;
  document.getElementById("member-overlay").style.display="none";
  safeAlert("Thanks! Try your scan again.");
};
function startMonitor(sym){
  safeAlert("Monitoring "+sym+" â€” requires $1.00 balance (payment enabled after deploy)");
}
// ---- REFERRAL PROGRAM (gamified) ----
// Set to your bot's username so invite links open the bot with the code.
const BOT_USERNAME = "war_arena_bot"; // TODO: replace with your real bot @username (no @)

async function renderReferral(){
  const r = await api("/referral");
  if(!r.ok || !r.referral) return;
  const ref = r.referral;
  const target = r.invitesPerReward || 10;
  const invited = ref.invited || 0;
  const inCycle = invited % target;              // progress within current milestone
  const remain = inCycle === 0 && invited > 0 ? 0 : target - inCycle;
  const pct = Math.min(100, Math.round((inCycle / target) * 100));

  const setTxt = (id,v)=>{ const el=document.getElementById(id); if(el) el.textContent=v; };
  const fill = document.getElementById("ref-fill"); if(fill) fill.style.width = pct + "%";
  setTxt("ref-count", inCycle);
  setTxt("ref-target", target);
  setTxt("ref-remain", remain);
  setTxt("ref-invited", invited);
  setTxt("ref-earned", ref.rewardsEarned || 0);

  // Build the Telegram deep-link invite (opens bot with the referral code).
  const link = "https://t.me/" + BOT_USERNAME + "?start=" + encodeURIComponent(ref.code);
  const box = document.getElementById("ref-link-box");
  const input = document.getElementById("ref-link");
  if(input){ input.value = link; }
  if(box){ box.style.display = "flex"; }

  const shareBtn = document.getElementById("ref-share");
  if(shareBtn) shareBtn.onclick = ()=> shareReferral(link);

  // Show claim button if there are unpaid rewards.
  const claimBtn = document.getElementById("ref-claim");
  if(claimBtn){
    if((r.pendingRewards||0) > 0){ claimBtn.style.display="block"; claimBtn.onclick = claimRewards; }
    else claimBtn.style.display="none";
  }
}

function shareReferral(link){
  const text = "âš” Join me on WAR ARENA â€” deterministic meme-coin market intelligence. Scan tokens, track smart wallets, read the battlefield.";
  // Telegram native share if available, else copy.
  try {
    if(TG && TG.openTelegramLink){
      TG.openTelegramLink("https://t.me/share/url?url=" + encodeURIComponent(link) + "&text=" + encodeURIComponent(text));
      return;
    }
  } catch(e){}
  try { navigator.clipboard.writeText(link); safeAlert("Invite link copied â€” share it with your squad!"); }
  catch(e){ safeAlert(link); }
}

async function claimRewards(){
  const r = await api("/referral/rewards", { method:"POST", body:"{}" });
  if(r.ok && r.count > 0){ safeAlert("Reward unlocked! "+r.count+" free monitor(s) added."); renderReferral(); }
  else safeAlert("No rewards to claim yet â€” keep recruiting!");
}

// ---- WAR FOUNDER WALLET (public identity; addresses are the single source of truth) ----
// Per spec Rule 11: the official addresses live in ONE controlled place. Replace
// the placeholders with the real public addresses once the wallets are created.
// Never store private keys / seed phrases anywhere in this app.
const FOUNDER_WALLET = {
  solana: { address: "SOLANA_ADDRESS_HERE", explorer: "https://solscan.io/account/" },
  evm:    { address: "0xEVM_ADDRESS_HERE",  explorer: "https://etherscan.io/address/" },
};

function fwShort(a){ return a.length>16 ? a.slice(0,6)+"â€¦"+a.slice(-6) : a; }

let FW_FOLLOWING = false;
async function fwLoadStatus(){
  const btn = document.getElementById("fw-follow");
  const cnt = document.getElementById("fw-count");
  if(!btn || !cnt) return;
  const r = await api("/founder");
  if(r.ok){
    FW_FOLLOWING = !!r.following;
    cnt.textContent = (r.followers!=null ? r.followers : 0).toLocaleString();
    fwSyncBtn();
  } else {
    cnt.textContent = "â€”";
  }
  btn.onclick = fwToggleFollow;
}
function fwSyncBtn(){
  const btn = document.getElementById("fw-follow");
  if(!btn) return;
  if(FW_FOLLOWING){ btn.textContent = "Following âœ“"; btn.classList.add("following"); }
  else { btn.textContent = "Follow"; btn.classList.remove("following"); }
}
async function fwToggleFollow(){
  const cnt = document.getElementById("fw-count");
  const r = await api(FW_FOLLOWING ? "/founder/unfollow" : "/founder/follow", { method:"POST", body:"{}" });
  if(r.ok){
    FW_FOLLOWING = !!r.following;
    if(cnt && r.followers!=null) cnt.textContent = r.followers.toLocaleString();
    fwSyncBtn();
  }
}

function fwRenderAddrs(){
  const box = document.getElementById("fw-addrs");
  if(!box) return;
  const row = (label, chains, w)=>{
    const configured = w.address && !w.address.includes("_HERE");
    const expBtn = configured
      ? "<a class='fwbtn' href='"+w.explorer+w.address+"' target='_blank' rel='noopener'>Explorer</a>"
      : "";
    const addrTxt = configured
      ? "<span data-copy='"+encodeURIComponent(w.address)+"' title='Tap to copy'>"+fwShort(w.address)+" â§‰</span>"
      : "not configured yet";
    return "<div class='fwrow'>"+
      "<div class='fwrow-l'><div class='fwlabel'>"+label+"</div><div class='fwchains'>"+chains+"</div></div>"+
      "<div class='fwaddr'>"+addrTxt+"</div>"+
      "<div class='fwacts'>"+expBtn+"</div></div>";
  };
  box.innerHTML =
    row("Solana", "SOL", FOUNDER_WALLET.solana) +
    row("EVM", "ETH Â· BSC Â· BASE", FOUNDER_WALLET.evm);
}

function fwCopy(text){
  try {
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(text); }
    else { const t=document.createElement("textarea"); t.value=text; document.body.appendChild(t); t.select(); document.execCommand("copy"); t.remove(); }
  } catch(e){}
}

// ---- Universal click-to-copy: any element with data-copy copies on click ----
function doCopy(value){
  if(!value) return false;
  let ok=false;
  try { if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(value); ok=true; } } catch(e){}
  if(!ok){
    try { const t=document.createElement("textarea"); t.value=value; t.style.position="fixed"; t.style.opacity="0"; t.style.top="0";
      document.body.appendChild(t); t.focus(); t.select(); try{t.setSelectionRange(0,value.length);}catch(e){} ok=document.execCommand("copy"); t.remove(); } catch(e){}
  }
  try { if(TG && TG.HapticFeedback) TG.HapticFeedback.notificationOccurred(ok?"success":"error"); } catch(e){}
  return ok;
}
// Delegated handler: click ANY element carrying data-copy â†’ copy its full value
// and flash a "Copied âœ“" confirmation. Works everywhere, no per-item wiring.
document.addEventListener("click", (e)=>{
  const el = e.target.closest ? e.target.closest("[data-copy]") : null;
  if(!el) return;
  const val = decodeURIComponent(el.getAttribute("data-copy")||"");
  const ok = doCopy(val);
  el.classList.add("copied-flash");
  const prev = el.getAttribute("data-copied-label");
  if(!prev){
    el.setAttribute("data-copied-label","1");
    const tip=document.createElement("span"); tip.className="copied-tip"; tip.textContent = ok?"Copied âœ“":"Copy failed";
    el.appendChild(tip);
    setTimeout(()=>{ tip.remove(); el.classList.remove("copied-flash"); el.removeAttribute("data-copied-label"); }, 1200);
  }
}, true);

// Back-compat: existing buttons that call intelCopy(this) still work.
function intelCopy(btn){
  const value = decodeURIComponent(btn.getAttribute("data-copy")||"");
  const ok = doCopy(value);
  if(btn){ btn.textContent = ok?"âœ“ COPIED":"COPY"; btn.classList.add("done"); setTimeout(()=>{ btn.textContent="COPY"; btn.classList.remove("done"); },1600); }
}

// ---- Address validation + chain auto-detection ----
function detectAddress(addr){
  const a = (addr||"").trim();
  if(!a) return { valid:false, family:null, reason:"empty" };
  if(a.startsWith("0x")){
    const ok = /^0x[0-9a-fA-F]{40}$/.test(a);
    return { valid:ok, family:"evm", reason: ok?"ok":"An EVM address is 0x + 40 hex characters." };
  }
  const ok = /^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(a);
  return { valid:ok, family:"sol", reason: ok?"ok":"A Solana address is 32â€“44 base58 characters." };
}

// ---- WALLET WATCH ----
let WW_CHAIN = "sol";

function wwInit(){
  const checkBtn = document.getElementById("ww-check");
  const subBtn = document.getElementById("ww-sub");
  if(checkBtn) checkBtn.onclick = wwCheckReputation;
  if(subBtn) subBtn.onclick = wwSubscribe;

  // Chain is auto-detected from the pasted address â€” no manual chips.
  const addrInp = document.getElementById("ww-addr");
  const ind = document.getElementById("ww-detected");
  if(addrInp){
    addrInp.addEventListener("input", ()=>{
      const det = detectAddress(addrInp.value);
      if(!addrInp.value.trim()){ if(ind){ind.textContent="Chain is detected from the address"; ind.className="chain-detected";} return; }
      if(det.family==="sol"){ WW_CHAIN="sol"; if(ind){ind.textContent="â—Ž Solana wallet detected"; ind.className="chain-detected ok";} }
      else if(det.family==="evm"){ WW_CHAIN="eth"; if(ind){ind.textContent="â—Ž EVM wallet â€” will check ETH Â· BSC Â· BASE"; ind.className="chain-detected ok";} }
      else { if(ind){ind.textContent="âœ• "+det.reason; ind.className="chain-detected bad";} }
    });
  }
}

async function wwCheckReputation(){
  const addr = document.getElementById("ww-addr").value.trim();
  const box = document.getElementById("ww-rep");
  if(!addr){ box.innerHTML = "<div class='muted'>Paste a wallet address first.</div>"; return; }
  box.innerHTML = "<div class='muted'>Checking on-chain reputationâ€¦</div>";
  const r = await api("/wallet-reputation?chain="+encodeURIComponent(WW_CHAIN)+"&wallet="+encodeURIComponent(addr));
  if(!r.ok || !r.reputation){ box.innerHTML = "<div class='muted'>Reputation unavailable for this wallet.</div>"; return; }
  const rep = r.reputation;
  const pct = rep.winRate==null ? "â€”" : Math.round(rep.winRate*100)+"%";
  const pnl = rep.realizedPnlUsd==null ? "â€”" : (rep.realizedPnlUsd>=0?"+":"")+"$"+Math.round(rep.realizedPnlUsd).toLocaleString();
  box.innerHTML =
    "<div class='wrep'>"+
      "<div class='wrep-verdict wrep-v-"+rep.verdict+"'>"+rep.verdict+"</div>"+
      "<div class='wrep-grid'>"+
        "<div class='wrep-cell'><div class='wrep-k'>WIN RATE</div><div class='wrep-val'>"+pct+"</div></div>"+
        "<div class='wrep-cell'><div class='wrep-k'>REALIZED PnL</div><div class='wrep-val'>"+pnl+"</div></div>"+
        "<div class='wrep-cell'><div class='wrep-k'>TOKENS TRADED</div><div class='wrep-val'>"+(rep.tokensTraded==null?"â€”":rep.tokensTraded)+"</div></div>"+
        "<div class='wrep-cell'><div class='wrep-k'>TRADES</div><div class='wrep-val'>"+(rep.totalTrades==null?"â€”":rep.totalTrades)+"</div></div>"+
      "</div></div>";
}

async function wwSubscribe(){
  const addr = document.getElementById("ww-addr").value.trim();
  const box = document.getElementById("ww-rep");
  if(!addr){ box.innerHTML = "<div class='muted'>Paste a wallet address first.</div>"; return; }
  const det = detectAddress(addr);
  if(!det.valid){ box.innerHTML = "<div class='muted'>"+det.reason+"</div>"; return; }
  // Guard against an EVM address with a Solana chip selected (or vice-versa).
  if(det.family==="sol" && WW_CHAIN!=="sol"){ box.innerHTML = "<div class='muted'>This is a Solana address â€” switch the chain to SOL.</div>"; return; }
  if(det.family==="evm" && WW_CHAIN==="sol"){ box.innerHTML = "<div class='muted'>This is an EVM address â€” pick BSC, BASE, or ETH.</div>"; return; }
  const r = await api("/wallet-watch", { method:"POST", body: JSON.stringify({ chain:WW_CHAIN, walletAddress:addr }) });
  if(r.status===402 && r.error==="WALLET_QUOTA_REACHED"){
    box.innerHTML = "<div class='muted'>You've reached your "+r.tier+" limit of "+r.maxWallets+" wallets. Upgrade above to watch more.</div>"; return;
  }
  if(r.status===402){ box.innerHTML = "<div class='muted'>Insufficient balance â€” top up in My Account.</div>"; return; }
  if(!r.ok){ box.innerHTML = "<div class='muted'>Could not start watching this wallet.</div>"; return; }
  document.getElementById("ww-addr").value = "";
  box.innerHTML = "";
  wwRenderList();
}

async function wwRenderList(){
  const box = document.getElementById("ww-list");
  const r = await api("/wallet-watch");
  const watches = (r.ok && Array.isArray(r.watches)) ? r.watches : [];
  // render tiers + quota
  wwRenderTiers(r.ok ? r : null);
  if(!watches.length){ box.innerHTML = "<div class='muted'>No watched wallets yet</div>"; return; }
  const quota = (r.ok && r.maxWallets!=null) ? "<div class='wquota'>"+watches.filter(w=>w.status==="ACTIVE").length+" / "+r.maxWallets+" wallets used</div>" : "";
  box.innerHTML = quota + watches.map(w=>{
    const short = w.walletAddress.length>14 ? w.walletAddress.slice(0,7)+"â€¦"+w.walletAddress.slice(-5) : w.walletAddress;
    const days = w.periodEndAt ? Math.max(0, Math.ceil((w.periodEndAt-Date.now())/86400000)) : 0;
    return "<div class='wwrow'><div class='wwrow-l'><div class='wwaddr' data-copy='"+encodeURIComponent(w.walletAddress)+"' title='Tap to copy Â· "+w.walletAddress+"'>"+short+"</div>"+
      "<div class='wwmeta'>"+(w.chain||"").toUpperCase()+" Â· "+w.status+" Â· "+days+"d left</div></div>"+
      "<div class='wwrow-acts'>"+
        "<button class='wwcancel' onclick=\"wwCancel('"+w.id+"')\">Cancel</button>"+
      "</div></div>";
  }).join("");
}

function wwRenderTiers(data){
  const box = document.getElementById("ww-tiers");
  if(!box) return;
  const tiers = (data && Array.isArray(data.tiers)) ? data.tiers :
    [{tier:"FREE",priceUsd:0,maxWallets:1,label:"Free"},{tier:"PRO",priceUsd:9.99,maxWallets:10,label:"Pro"},{tier:"ELITE",priceUsd:29.99,maxWallets:50,label:"Elite"}];
  const current = (data && data.tier) ? data.tier : "FREE";
  box.innerHTML = tiers.map(t=>{
    const price = t.priceUsd===0 ? "Free" : "$"+t.priceUsd+"/mo";
    const isCurrent = t.tier===current;
    return "<div class='wtier"+(isCurrent?" current":"")+"' onclick=\"wwUpgrade('"+t.tier+"')\">"+
      "<div class='wtier-name'>"+t.label+(isCurrent?" âœ“":"")+"</div>"+
      "<div class='wtier-price'>"+price+"</div>"+
      "<div class='wtier-max'>"+t.maxWallets+" wallet"+(t.maxWallets>1?"s":"")+"</div></div>";
  }).join("");
}

async function wwUpgrade(tier){
  if(tier==="FREE") return; // can't "buy" free
  const r = await api("/wallet-watch/subscribe", { method:"POST", body: JSON.stringify({ tier }) });
  if(r.status===402){ alert("Insufficient balance â€” top up in My Account to upgrade."); return; }
  if(r.ok){ wwRenderList(); }
}

async function wwCancel(id){
  await api("/wallet-watch/cancel", { method:"POST", body: JSON.stringify({ watchId:id }) });
  wwRenderList();
}

function wwRenderScreen(){
  wwRenderList();
  // If a wallet was queued from WAR INTEL (quota was full), offer a one-tap add
  // once the user has upgraded.
  const pend = (typeof window!=="undefined") ? window.__pendingWatch : null;
  const introEl = document.getElementById("ww-tiers");
  if(pend && introEl && !document.getElementById("ww-pending")){
    const box = document.createElement("div");
    box.id = "ww-pending";
    box.style.cssText = "margin-top:12px;padding:11px 13px;border-radius:11px;background:rgba(240,140,70,.1);border:1px solid rgba(240,140,70,.35);font-family:var(--mono);font-size:11px;color:var(--sub);display:flex;align-items:center;justify-content:space-between;gap:10px";
    box.innerHTML = "<span>âš” Pending from INTEL: "+(pend.wallet.slice(0,6)+"â€¦"+pend.wallet.slice(-4))+"</span>"
      + "<button class='btn gold' style='padding:7px 14px;flex:0 0 auto' onclick='wwAddPending()'>Watch now</button>";
    introEl.parentNode.insertBefore(box, introEl.nextSibling);
  }
}
async function wwAddPending(){
  const pend = window.__pendingWatch; if(!pend) return;
  const r = await api("/wallet-watch", { method:"POST", body: JSON.stringify({ chain:pend.chain, walletAddress:pend.wallet }) });
  if(r.ok){ window.__pendingWatch = null; const el=document.getElementById("ww-pending"); if(el) el.remove(); wwRenderList(); safeAlert("âœ“ Now watching this wallet."); }
  else if(r.status===402 && r.error==="WALLET_QUOTA_REACHED"){ safeAlert("Still at your limit â€” upgrade to a higher tier first."); }
  else safeAlert("Could not add â€” check your balance/tier.");
}

function goAccount(){ document.querySelector('.nav button[data-s="account"]').click(); }

// ---- ACCOUNT ----
function renderAccount(){
  fwRenderAddrs();
  fwLoadStatus();
  renderReferral();
  document.getElementById("acct-balance").textContent = usd(ACCT.balanceUsd);
  document.getElementById("acct-free").textContent = ACCT.freeScansRemaining+" free scans left today";
  const tierEl = document.getElementById("acct-tier"); tierEl.textContent = ACCT.tier;
  document.getElementById("packs").innerHTML = DEMO.packs.map(p=>
    "<div class='pack"+(p.command?" command":"")+"' onclick='buyPack(\""+p.id+"\","+p.price+","+p.bonus+","+(p.command?"true":"false")+")'>"+
    "<div><div style='font-family:var(--mono);font-size:13px"+(p.command?";color:var(--gold)":"")+"'>"+p.label+"</div>"+
    (p.bonus>0?"<div class='b'>+"+usd0(p.bonus)+" bonus credit</div>":"")+"</div>"+
    "<div class='p'"+(p.command?" style='color:var(--gold)'":"")+">"+usd0(p.price)+"</div></div>"
  ).join("");
}
function buyPack(id, price, bonus, command){
  // Real payment happens via Telegram Stars / TON after deploy. Here we show the
  // honest flow and (in demo) credit locally so the UX is walkable.
  const msg = "Top up "+usd0(price)+(bonus>0?" + "+usd0(bonus)+" bonus":"")+" = "+usd0(price+bonus)+" credit"+(command?" + COMMAND upgrade":"");
  const proceed = ()=>{ ACCT.balanceUsd += price+bonus; if(command) ACCT.tier="COMMAND"; syncWallet(); renderAccount(); };
  safeConfirm(msg+"\n(real payment enabled after deploy)", ok=>{ if(ok) proceed(); });
}

// ---- BATTLEFIELD ARENA (GPU-driven: cores, halos, wallets, gravity flows, shockwaves, dust) ----
(function(){
  const canvas=document.getElementById("gl");
  const gl=canvas.getContext("webgl",{antialias:true,alpha:true,premultipliedAlpha:false});
  const bg=document.getElementById("gbg"), bx=bg?bg.getContext("2d"):null;
  const DPR=Math.min(2,window.devicePixelRatio||1);
  if(!gl){ document.getElementById("ghint").textContent="WebGL unavailable"; return; }

  const LANE={SMART_MONEY:[0.31,0.82,0.66],KOL:[0.94,0.71,0.30],FOLLOW_WALLET:[0.36,0.55,1.0],OTHER:[0.45,0.50,0.62]};
  const EXIT=[1.0,0.36,0.42];
  function hsv(h,s,v){h=(h%1+1)%1;const i=Math.floor(h*6),f=h*6-i,p=v*(1-s),q=v*(1-f*s),tt=v*(1-(1-f)*s);return [[v,tt,p],[q,v,p],[p,v,tt],[p,q,v],[tt,p,v],[v,p,q]][i%6];}
  const MOOD_ID={OBSERVING:0,ACCUMULATION:1,ATTACK:2,DOMINANCE:3,DISTRIBUTION:4,BLEEDING:5,COLLAPSE:6,DORMANT:7,EMERGING:8,UNKNOWN:0};
  const fr0=f=>(f&&typeof f.raw==="number")?f.raw:(typeof f==="number"?f:0);

  let W,H,ASP,COUNT=0,built=false;
  let P_POS,P_TOK,P_KIND,P_COL,P_PARM, wallets=[], TX=[],TY=[];
  let packA,packB,packC, staticBufs=null, linePos,lineCol,bLine,bLineCol;
  let prog,lprog,aSeed,aTok,aKind,aCol,aParm,uAsp,uZoom,uClock,uCam,U,laP,laC,luAsp,luCam,luZoom;
  let zoom=0.62,tZoom=1,camX=0,camY=0.06,introT=0;const introDur=2.6;
  const easeOut=x=>1-Math.pow(1-x,3);
  let focus=-1,hover=-1;
  const layer=document.getElementById("gLabels");
  let labels=[];

  const VS="precision highp float;attribute vec2 aSeed;attribute float aTok;attribute float aKind;attribute vec3 aCol;attribute vec4 aParm;uniform float uAsp,uZoom,uClock;uniform vec2 uCam;uniform vec4 uA[8],uB[8],uC[8];varying vec3 vCol;varying float vAlpha;varying float vStar;float hash(float n){return fract(sin(n)*43758.5453123);}void main(){int ti=int(aTok);vec2 tp=vec2(0.);float focus=1.;float ux=0.,uy=0.,ucore=0.,uhalo=0.06,upow=0.5,uthr=0.3,uatt=0.5,umood=0.,uevent=0.;if(aTok>=0.){for(int i=0;i<8;i++){if(i==ti){ux=uA[i].x;uy=uA[i].y;ucore=uA[i].w;uhalo=uB[i].x;upow=uB[i].y;uthr=uB[i].z;uatt=uB[i].w;umood=uC[i].x;uevent=uC[i].y;focus=uC[i].z;}}tp=vec2(ux,uy);}vec2 p=tp;float size=2.;vec3 col=aCol;float alpha=1.;float star=0.;float T=uClock;if(aKind<0.5){float sm=aParm.x;float pulse=(umood>1.5&&umood<2.5)?(1.+0.05*sin(T*3.)):(umood>2.5&&umood<3.5)?1.03:(umood>6.5)?0.85:1.;float jit=uthr*0.002*sin(T*4.+float(ti)*3.);p+=vec2(jit,jit*0.7);size=ucore*pulse*sm;col*=focus;if(sm<1.2){star=(0.5+0.8*uatt)*focus;}}else if(aKind<1.5){float ang=aSeed.x+T*0.08*((umood>1.5&&umood<2.5)?1.6:1.);float rad=uhalo*(0.92+0.12*sin(T*1.5+aSeed.y*6.));float agit=uthr*0.018*sin(T*9.+aSeed.x*5.+aSeed.y*10.);p+=vec2(cos(ang)*(rad+agit),sin(ang)*(rad+agit)*0.8);float br=(0.22+0.32*upow+0.34*uthr)*(0.6+0.4*sin(T*3.+aSeed.x*3.));col=vec3((0.32*upow+1.*uthr)*br,(0.55*upow+0.34*uthr)*br,(1.*upow+0.40*uthr)*br);size=(1.8+2.6*uatt);col*=focus;}else if(aKind<2.5){float baseAng=aSeed.x,rad=aSeed.y;float dir=aParm.z,whale=aParm.y;float ang=baseAng+T*(0.12+0.06*hash(aSeed.x))*dir;p+=vec2(cos(ang)*rad,sin(ang)*rad*0.8);float pulse=whale>0.5?(1.+0.22*sin(T*4.+ang*2.)):1.;float tw=((whale>0.5?0.9:0.7)+0.3*sin(T*3.+ang*4.))*focus;col=aCol*tw;size=aParm.x*pulse;if(whale>0.5){star=0.4*focus;}}else if(aKind<3.5){float ang=aSeed.x,rad=aSeed.y;float seed=aParm.x,dir=aParm.y,whale=aParm.z,wob=aParm.w;float speed=0.16+0.12*hash(seed*7.);float t=fract(seed+T*speed);float prog=dir>0.?(1.-t):t;float curve=(1.-prog)*(1.-prog)*0.12*(whale>0.5?1.4:1.);float rr=prog*rad;float a2=ang+curve*sin(T*0.6+seed*6.28);vec2 wobv=vec2(sin(T*4.+wob),cos(T*3.5+wob))*0.004*(1.-abs(prog-0.5)*2.);p+=vec2(cos(a2)*rr,sin(a2)*rr*0.8)+wobv;float headFade=sin(prog*3.14159);if(dir>0.){float b=headFade*(whale>0.5?2.1:1.7)*(0.65+0.5*(1.-prog));col=aCol*b*focus;size=(2.2+5.5*headFade*(1.-prog*0.35)*(whale>0.5?1.3:1.));}else{float b=headFade*1.25*(0.45+0.65*prog);col=aCol*b*focus;size=(1.8+3.6*headFade);}}else if(aKind<4.5){float period=5.;float ph=fract((T+aSeed.y*period)/period);float R=ph*(uhalo*3.4);float fade=1.-ph;float ang=aSeed.x;p+=vec2(cos(ang)*R,sin(ang)*R*0.8);col=aCol*fade*0.9*focus;size=(1.4+2.2*fade);if(uevent<0.5)alpha=0.;}else{vec2 d=aSeed*2.-1.;d.x+=0.06*sin(T*0.05+aSeed.y*6.28);d.y+=0.04*cos(T*0.04+aSeed.x*6.28);p=d*0.9;float depth=aParm.x;float tw=0.4+0.6*abs(sin(T*0.5+aSeed.x*10.));col=aCol*tw*0.5*(0.4+0.6*depth);size=(0.8+1.6*depth);}vec2 sp=(p-uCam)*uZoom;gl_Position=vec4(sp.x/uAsp,sp.y,0.,1.);gl_PointSize=max(1.,size*uZoom);vCol=col;vAlpha=alpha;vStar=star;}";
  const FS="precision highp float;varying vec3 vCol;varying float vAlpha;varying float vStar;vec3 tonemap(vec3 x){return (x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14);}void main(){if(vAlpha<0.01)discard;vec2 u=gl_PointCoord-0.5;float d=length(u);if(d>0.5)discard;float core=exp(-d*d*11.);float halo=exp(-d*d*4.)*0.38;float glow=core+halo;float ang=atan(u.y,u.x);float rays=(pow(abs(cos(ang*2.)),40.)+pow(abs(sin(ang*2.)),40.));float star=rays*smoothstep(0.5,0.,d)*vStar;glow+=star*0.32;vec3 c=mix(vCol,vec3(1.,0.98,0.92),pow(core,3.)*0.5);c*=glow*1.05;c=tonemap(c);float a=clamp(glow,0.,1.)*vAlpha;gl_FragColor=vec4(c,a);}";
  const LVS="attribute vec2 aP;attribute vec3 aC;uniform float uAsp,uZoom;uniform vec2 uCam;varying vec3 vC;void main(){vec2 p=(aP-uCam)*uZoom;gl_Position=vec4(p.x/uAsp,p.y,0.,1.);vC=aC;}";
  const LFS="precision highp float;varying vec3 vC;void main(){gl_FragColor=vec4(vC,1.);}";
  function sh(t,s){const o=gl.createShader(t);gl.shaderSource(o,s);gl.compileShader(o);if(!gl.getShaderParameter(o,gl.COMPILE_STATUS))console.error(gl.getShaderInfoLog(o));return o;}

  function initGL(){
    prog=gl.createProgram();gl.attachShader(prog,sh(gl.VERTEX_SHADER,VS));gl.attachShader(prog,sh(gl.FRAGMENT_SHADER,FS));gl.linkProgram(prog);gl.useProgram(prog);
    lprog=gl.createProgram();gl.attachShader(lprog,sh(gl.VERTEX_SHADER,LVS));gl.attachShader(lprog,sh(gl.FRAGMENT_SHADER,LFS));gl.linkProgram(lprog);
    aSeed=gl.getAttribLocation(prog,"aSeed");aTok=gl.getAttribLocation(prog,"aTok");aKind=gl.getAttribLocation(prog,"aKind");aCol=gl.getAttribLocation(prog,"aCol");aParm=gl.getAttribLocation(prog,"aParm");
    uAsp=gl.getUniformLocation(prog,"uAsp");uZoom=gl.getUniformLocation(prog,"uZoom");uClock=gl.getUniformLocation(prog,"uClock");uCam=gl.getUniformLocation(prog,"uCam");
    U={A:gl.getUniformLocation(prog,"uA"),B:gl.getUniformLocation(prog,"uB"),C:gl.getUniformLocation(prog,"uC")};
    laP=gl.getAttribLocation(lprog,"aP");laC=gl.getAttribLocation(lprog,"aC");luAsp=gl.getUniformLocation(lprog,"uAsp");luCam=gl.getUniformLocation(lprog,"uCam");luZoom=gl.getUniformLocation(lprog,"uZoom");
    gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE);
  }

  // (Re)build all particle buffers from the current DEMO.worlds (trending data)
  function build(){
    const WORLDS=DEMO.worlds.slice(0,8); // uniform arrays sized 8
    const NW=WORLDS.length;
    WORLDS.forEach((w,i)=>{const a=i/NW*6.2831*1.25+0.6,r=0.30+i*0.085;w._x=Math.cos(a)*r;w._y=Math.sin(a)*r*0.66;
      w._core=9+fr0(w.attention)*0.4;w._halo=0.055+fr0(w.power)/100*0.10;});
    const POS=[],TOK=[],KIND=[],COL=[],PARM=[];wallets=[];TX=[];TY=[];
    const push=(kind,tok,col,a0,a1,p0,p1,p2,p3)=>{KIND.push(kind);TOK.push(tok);COL.push(col[0],col[1],col[2]);POS.push(a0,a1);PARM.push(p0,p1,p2,p3);};
    packA=new Float32Array(32);packB=new Float32Array(32);packC=new Float32Array(32);
    WORLDS.forEach((w,i)=>{ TX[i]=w._x;TY[i]=w._y;
      packA[i*4]=w._x;packA[i*4+1]=w._y;packA[i*4+2]=(typeof w.hue==="number"?w.hue:0.55);packA[i*4+3]=w._core;
      packB[i*4]=w._halo;packB[i*4+1]=fr0(w.power)/100;packB[i*4+2]=fr0(w.threat)/100;packB[i*4+3]=fr0(w.attention)/100;
      packC[i*4]=MOOD_ID[w.mood]||0;packC[i*4+1]=(w.events&&w.events.some(e=>/BUY/.test(e.type)))?1:((w.events&&w.events.some(e=>/SELL/.test(e.type)))?2:0);packC[i*4+2]=1;packC[i*4+3]=0;
    });
    // cores
    WORLDS.forEach((w,i)=>{const base=hsv(typeof w.hue==="number"?w.hue:0.55,0.5,1.0);[[3.1,0.16],[1.8,0.4],[1.0,1.0]].forEach(([sm,br])=>push(0,i,[base[0]*br,base[1]*br,base[2]*br],0,0,sm,0,0,0));});
    // halos
    const HALO=26;WORLDS.forEach((w,i)=>{for(let k=0;k<HALO;k++)push(1,i,[1,1,1],k/HALO*6.2831,Math.random(),0,0,0,0);});
    // wallets + flows
    WORLDS.forEach((w,i)=>{(w.flow||[]).forEach((f,idx)=>{const side=f.side,lane=f.lane,usd=f.amountUsd||0;
      const hue=side==="sell"?EXIT:(LANE[lane]||LANE.OTHER);const whale=usd>=7000;
      const ang=idx/Math.max(1,(w.flow||[]).length)*6.2831+Math.random()*0.3;const rad=w._halo+0.05+Math.random()*0.02;
      const size=4+Math.min(18,Math.pow(usd/1000,0.85)*1.6);
      push(2,i,hue,ang,rad,size,whale?1:0,(side==="buy"?1:-1),0);
      wallets.push({i,ang,rad,hue,whale,side});
      const count=Math.max(5,Math.min(32,Math.round(usd/450)));
      for(let c=0;c<count;c++)push(3,i,hue,ang+(Math.random()-0.5)*0.5,rad,Math.random(),side==="buy"?1:-1,whale?1:0,Math.random()*6.28);
    });});
    // shocks
    const SHOCK=54;WORLDS.forEach((w,i)=>{const ev=(w.events&&w.events.length);if(ev){const hue=(w.events.some(e=>/BUY/.test(e.type)))?[0.31,0.82,0.66]:EXIT;for(let k=0;k<SHOCK;k++)push(4,i,hue,k/SHOCK*6.2831,Math.random(),0,0,0,0);}});
    // dust
    const DUST=1000;for(let k=0;k<DUST;k++){const shade=0.3+Math.random()*0.5;push(5,-1,[0.6*shade,0.7*shade,1.0*shade],Math.random(),Math.random(),Math.random(),Math.random(),0,0);}
    P_POS=new Float32Array(POS);P_TOK=new Float32Array(TOK);P_KIND=new Float32Array(KIND);P_COL=new Float32Array(COL);P_PARM=new Float32Array(PARM);
    COUNT=KIND.length;
    linePos=new Float32Array(wallets.length*4);lineCol=new Float32Array(wallets.length*6);
    if(!bLine){bLine=gl.createBuffer();bLineCol=gl.createBuffer();}
    // static buffers
    staticBufs={aSeed:{loc:aSeed,data:P_POS,size:2},aTok:{loc:aTok,data:P_TOK,size:1},aKind:{loc:aKind,data:P_KIND,size:1},aCol:{loc:aCol,data:P_COL,size:3},aParm:{loc:aParm,data:P_PARM,size:4}};
    for(const k in staticBufs){const s=staticBufs[k];s.buffer=s.buffer||gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,s.buffer);gl.bufferData(gl.ARRAY_BUFFER,s.data,gl.STATIC_DRAW);}
    gl.useProgram(prog);gl.uniform4fv(U.A,packA);gl.uniform4fv(U.B,packB);
    // labels
    layer.innerHTML="";
    labels=WORLDS.map((w,i)=>{const d=document.createElement("div");d.className="glbl";const c=MOOD_HEX[w.mood]||"#93a0b5";
      d.innerHTML="<div style='color:"+c+";font-size:12px;font-weight:600;text-shadow:0 0 12px "+c+"'>"+w.sym+"</div><div style='color:"+c+";font-size:8px;letter-spacing:.1em'>"+w.mood+"</div>";
      d.onclick=()=>renderScan(w,false);layer.appendChild(d);return d;});
    built=true;
  }
  window.rebuildArena=function(){ if(gl) build(); }; // called after loadTrending
  // Update the always-visible data-mode badge. Three honest states:
  //  LIVE        â€” real tokens AND real on-chain wallets (server sent flowEntities)
  //  LIVE-TOKENS â€” real tokens, but orbiting wallets are an illustrative simulation
  //  DEMO        â€” everything is sample data (server offline / not configured)
  window.setArenaMode=function(mode){
    const el=document.getElementById("dataMode"); if(!el) return;
    const M={
      "LIVE":       "â— LIVE DATA Â· on-chain",
      "LIVE-TOKENS":"â— LIVE TOKENS Â· flow simulated",
      "DEMO":       "â— DEMO Â· SIMULATED",
    };
    el.setAttribute("data-mode", mode in M ? mode : "DEMO");
    el.textContent = M[mode] || M.DEMO;
  };

  function rz(){W=canvas.width=innerWidth*DPR|0;H=canvas.height=innerHeight*DPR|0;if(bg){bg.width=W;bg.height=H;bg.style.width=innerWidth+"px";bg.style.height=innerHeight+"px";}ASP=W/H;gl.viewport(0,0,W,H);}
  addEventListener("resize",rz);
  canvas.addEventListener("wheel",e=>{e.preventDefault();tZoom*=e.deltaY<0?1.12:0.89;tZoom=Math.max(0.6,Math.min(3.2,tZoom));introT=1;},{passive:false});
  let pinch=0;
  canvas.addEventListener("touchmove",e=>{if(e.touches.length===2){e.preventDefault();const dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY,dd=Math.hypot(dx,dy);if(pinch){tZoom*=dd/pinch;tZoom=Math.max(0.6,Math.min(3.2,tZoom));introT=1;}pinch=dd;}},{passive:false});
  canvas.addEventListener("touchend",()=>pinch=0);
  function pick(px,py){const wx=((px/innerWidth)*2-1)*ASP/zoom+camX,wy=((0.5-py/innerHeight)*2)/zoom+camY;let best=-1,bd=1e9;for(let i=0;i<TX.length;i++){const dx=TX[i]-wx,dy=TY[i]-wy,dd=dx*dx+dy*dy;if(dd<bd){bd=dd;best=i;}}return bd<0.05?best:-1;}
  canvas.addEventListener("click",e=>{const b=canvas.getBoundingClientRect();const p=pick(e.clientX-b.left,e.clientY-b.top);
    if(p>=0){ focus=p; const w=DEMO.worlds[p]; if(w) renderScan(w, false); }});
  canvas.addEventListener("mousemove",e=>{if(matchMedia&&matchMedia("(pointer:coarse)").matches)return;const b=canvas.getBoundingClientRect();hover=pick(e.clientX-b.left,e.clientY-b.top);});
  function w2s(x,y){const px=(x-camX)*zoom,py=(y-camY)*zoom;return{x:(px/ASP*0.5+0.5)*innerWidth,y:(0.5-py*0.5)*innerHeight};}

  function drawBG(T){ if(!bx)return; bx.clearRect(0,0,bg.width,bg.height);
    const clouds=[["#2340c8",0.24,0.28,0.62],["#0d7a5a",0.74,0.68,0.56],["#7a1f9e",0.56,0.40,0.5],["#c23a2e",0.40,0.72,0.36]];
    clouds.forEach(([c,cx,cy,r],i)=>{const gx=(cx+0.03*Math.sin(T*0.05+i))*bg.width,gy=(cy+0.03*Math.cos(T*0.04+i))*bg.height;const rad=r*bg.width,g=bx.createRadialGradient(gx,gy,0,gx,gy,rad);g.addColorStop(0,c+"55");g.addColorStop(0.5,c+"22");g.addColorStop(1,c+"00");bx.globalCompositeOperation="screen";bx.fillStyle=g;bx.beginPath();bx.arc(gx,gy,rad,0,6.28);bx.fill();});
    bx.globalCompositeOperation="source-over";
  }

  let t0=performance.now();
  function frame(now){
    const dt=Math.min(0.05,(now-t0)/1000);t0=now;const T=now/1000;
    if(!built){requestAnimationFrame(frame);return;}
    if(introT<1){introT=Math.min(1,introT+dt/introDur);const e=easeOut(introT);zoom=0.62+(1-0.62)*e;camY=0.06+(0-0.06)*e;}else zoom+=(tZoom-zoom)*0.08;
    camX=Math.sin(T*0.06)*0.018;if(introT>=1)camY=Math.cos(T*0.045)*0.012;
    const active=focus>=0?focus:hover;
    for(let i=0;i<8;i++){const tgt=active<0?1:(i===active?1.35:0.4);packC[i*4+2]+=(tgt-packC[i*4+2])*0.12;}
    drawBG(T);
    // beams
    let li=0;
    for(const wl of wallets){const wx=TX[wl.i]+Math.cos(wl.ang+T*0.13*(wl.side==="buy"?1:-1))*wl.rad,wy=TY[wl.i]+Math.sin(wl.ang+T*0.13*(wl.side==="buy"?1:-1))*wl.rad*0.8;
      const a=(wl.whale?0.5:0.26)*(active<0?1:(wl.i===active?1.2:0.35));
      linePos[li*4]=wx;linePos[li*4+1]=wy;linePos[li*4+2]=TX[wl.i];linePos[li*4+3]=TY[wl.i];
      lineCol[li*6]=wl.hue[0]*a;lineCol[li*6+1]=wl.hue[1]*a;lineCol[li*6+2]=wl.hue[2]*a;lineCol[li*6+3]=wl.hue[0]*a*0.12;lineCol[li*6+4]=wl.hue[1]*a*0.12;lineCol[li*6+5]=wl.hue[2]*a*0.12;li++;}
    gl.clear(gl.COLOR_BUFFER_BIT);
    if(li>0){gl.useProgram(lprog);gl.uniform1f(luAsp,ASP);gl.uniform2f(luCam,camX,camY);gl.uniform1f(luZoom,zoom);
      gl.bindBuffer(gl.ARRAY_BUFFER,bLine);gl.bufferData(gl.ARRAY_BUFFER,linePos.subarray(0,li*4),gl.DYNAMIC_DRAW);gl.enableVertexAttribArray(laP);gl.vertexAttribPointer(laP,2,gl.FLOAT,false,0,0);
      gl.bindBuffer(gl.ARRAY_BUFFER,bLineCol);gl.bufferData(gl.ARRAY_BUFFER,lineCol.subarray(0,li*6),gl.DYNAMIC_DRAW);gl.enableVertexAttribArray(laC);gl.vertexAttribPointer(laC,3,gl.FLOAT,false,0,0);
      gl.drawArrays(gl.LINES,0,li*2);}
    gl.useProgram(prog);gl.uniform1f(uAsp,ASP);gl.uniform1f(uZoom,zoom);gl.uniform1f(uClock,T);gl.uniform2f(uCam,camX,camY);gl.uniform4fv(U.C,packC);
    for(const k in staticBufs){const s=staticBufs[k];gl.bindBuffer(gl.ARRAY_BUFFER,s.buffer);gl.enableVertexAttribArray(s.loc);gl.vertexAttribPointer(s.loc,s.size,gl.FLOAT,false,0,0);}
    gl.drawArrays(gl.POINTS,0,COUNT);
    for(let i=0;i<labels.length;i++){const s=w2s(TX[i],TY[i]-0.10);const el=labels[i];el.style.left=s.x+"px";el.style.top=s.y+"px";el.style.opacity=zoom>0.8?1:0.65;}
    requestAnimationFrame(frame);
  }

  initGL(); rz(); build(); requestAnimationFrame(frame);
})();

// ---- live state from the server (promotion / membership / limits) ----
const LIVE = { promotion:{active:false,freeUntilMs:null}, membership:{enabled:false}, isMember:true, dataMode:"DEMO" };

function fmtDate(ms){ try{ return new Date(ms).toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"}); }catch(e){ return ""; } }

// ---- onboarding: shown during launch month only; hidden after it ends ----
let ONBOARD_DISMISSED = false;
function maybeShowOnboarding(){
  // Only during the active launch window. After the month ends, promotion.active
  // is false server-side -> this never shows, so the window disappears on its own.
  if(!LIVE.promotion || !LIVE.promotion.active) return;
  if(ONBOARD_DISMISSED) return;
  // Let the cinematic arena intro play first (~1.3s), THEN reveal the explainer
  // over it â€” so the user sees the living battlefield behind the card.
  setTimeout(()=>{
    if(ONBOARD_DISMISSED) return;
    document.getElementById("onboard-overlay").style.display = "flex";
  }, 1300);
}
document.getElementById("onboard-close").onclick = ()=>{
  if(document.getElementById("onboard-dismiss").checked) ONBOARD_DISMISSED = true;
  document.getElementById("onboard-overlay").style.display = "none";
};

function renderPromoBanner(){
  const el = document.getElementById("promo-banner"); if(!el) return;
  if(LIVE.promotion && LIVE.promotion.active){
    const until = LIVE.promotion.freeUntilMs ? (" until "+fmtDate(LIVE.promotion.freeUntilMs)) : "";
    el.style.display = "block";
    el.innerHTML = "ðŸŽ‰ <b>Launch month:</b> 3 free scans/day + 1 free 24h monitor/week"+until+".";
    const cost = document.getElementById("scanCost"); if(cost) cost.textContent = "3 free /day this month";
  } else {
    el.style.display = "none";
  }
}

// ---- boot: try live account, else demo ----
// ---- load trending tokens from the server into the arena (live) ----
// Maps each server WorldState into the shape the galaxy + renderScan expect.
// Browsing is free: this hits the public /trending endpoint (cached 4h server-side).
function symFromAddr(a){ return "$"+String(a||"").slice(0,4).toUpperCase(); }
// Build representative wallet flow entities from trending stats. Trending gives
// aggregate buys/sells/smartMoney (not individual wallets), so we synthesize a
// small set of flow entities that reflect the real balance + lanes â€” enough to
// drive the living arena (orbiting wallets, connection beams, money flows).
function buildFlowFromStats(w, st){
  // if the server ever sends real flowEntities, prefer them â€” mark them LIVE.
  if(Array.isArray(w.flowEntities) && w.flowEntities.length){
    return w.flowEntities.map(f=>({maker:f.maker,side:f.side,amountUsd:f.amountUsd,lane:f.lane,sim:false}));
  }
  if(!st) return [];
  const buys = st.buys||0, sells = st.sells||0, smart = st.smartMoney||0;
  const liq = st.liquidity||st.marketCap||10000;
  const tot = buys + sells;
  if(tot === 0) return [];
  // decide how many wallet nodes to show (cap for perf/clarity)
  const N = Math.max(3, Math.min(9, Math.round(smart>0 ? smart/2 : 5)));
  const buyShare = buys/tot;
  const out = [];
  const rnd = (seed=>()=>((seed=(seed*9301+49297)%233280)/233280))(Math.floor((st.holders||100)+buys));
  for(let i=0;i<N;i++){
    const isBuy = rnd() < buyShare;
    // lane: first few smart-money-heavy, else mixed
    let lane;
    const r = rnd();
    if(i < Math.min(smart, 3) && smart>0) lane = "SMART_MONEY";
    else if(r < 0.2) lane = "KOL";
    else if(r < 0.45) lane = "FOLLOW_WALLET";
    else lane = "OTHER";
    // amount scaled off liquidity, with whales occasionally
    const base = liq * (0.02 + rnd()*0.06);
    const whale = rnd() < 0.25;
    const amt = Math.round(base * (whale ? 2.5 : 1));
    out.push({ maker: (isBuy?"Buy":"Sell")+"-"+i, side: isBuy?"buy":"sell", amountUsd: amt, lane, sim: true });
  }
  return out;
}

function mapWorld(w){
  const forceRaw = f => (f && typeof f.raw==="number") ? f.raw : (typeof f==="number"?f:0);
  const st = w.stats || null;
  const sym = (st && st.symbol) ? ("$"+String(st.symbol).replace(/^\$/,"")) : (w.symbol || symFromAddr(w.address));
  return {
    sym: sym,
    address: (w.address||"").slice(0,4)+"â€¦"+(w.address||"").slice(-4),
    fullAddress: w.address, chain: w.chain || "sol",
    hue: typeof w.hue==="number" ? w.hue : 0.55,
    mood: w.mood || "OBSERVING",
    trajectory:w.trajectory||"UNKNOWN", coherence:w.coherence||"UNKNOWN", leadLag:w.leadLag||"UNKNOWN", regime:w.regime||"UNKNOWN",
    power:{raw:forceRaw(w.power),band:(w.power&&w.power.band)||"â€”"},
    threat:{raw:forceRaw(w.threat),band:(w.threat&&w.threat.band)||"â€”"},
    confidence:{raw:forceRaw(w.confidence),band:(w.confidence&&w.confidence.band)||"â€”"},
    attention:{raw:forceRaw(w.attention),band:(w.attention&&w.attention.band)||"â€”"},
    flow: buildFlowFromStats(w, st),
    events:w.events||[], signals:w.signals||[], whyNow:w.whyNow||[],
    dataQuality:w.dataQuality||"UNKNOWN", qualityReasons:w.qualityReasons||[], insufficient:w.insufficient||[],
    analysis: w.analysis || null,
    stats: st || (w.marketCap!=null||w.holders!=null ? {
      marketCap:w.marketCap, liquidity:w.liquidity, holders:w.holders, top10Rate:w.top10Rate,
      rugRatio:w.rugRatio, washTrading:w.washTrading, smartMoney:w.smartMoney, renowned:w.renowned,
      buys:w.buys, sells:w.sells, priceUsd:w.priceUsd,
    } : null),
  };
}
async function loadTrending(){
  // Retry a few times: on a cold-started free instance the first request can
  // take ~50s while the server wakes. We show a "waking the market" state and
  // keep trying rather than falling back to fake tokens.
  for(let attempt=0; attempt<6; attempt++){
    const t = await api("/trending");
    if(t.ok && Array.isArray(t.tokens) && t.tokens.length){
      DEMO.worlds = t.tokens.map(mapWorld);
      const anyRealWallets = DEMO.worlds.some(w => (w.flow||[]).some(f => f.sim === false));
      LIVE.dataMode = anyRealWallets ? "LIVE" : "LIVE-TOKENS";
      if(window.setArenaMode) window.setArenaMode(LIVE.dataMode);
      if(window.rebuildArena) window.rebuildArena();
      hideArenaLoading();
      return true;
    }
    // not ready yet â€” wait and retry (server waking, or trending refreshing)
    await new Promise(r=>setTimeout(r, attempt===0 ? 1500 : 8000));
  }
  // Could not load live trending â€” show an honest empty state, NOT fake tokens.
  showArenaEmpty();
  return false;
}

// ---- Arena live-loading state (replaces demo fallback) ----
// The arena shows real trending only. While the server wakes / trending loads,
// we show a tasteful loading hint instead of fake tokens.
function arenaHintEl(){
  let el = document.getElementById("arena-hint");
  if(!el){
    el = document.createElement("div");
    el.id = "arena-hint";
    el.style.cssText = "position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:5;"
      + "font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--sub);text-align:center;"
      + "background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 22px;"
      + "backdrop-filter:blur(14px);max-width:80%;line-height:1.6";
    document.body.appendChild(el);
  }
  return el;
}
function showArenaLoading(){
  DEMO.worlds = []; // never render fake tokens
  if(window.rebuildArena) window.rebuildArena();
  const el = arenaHintEl();
  el.innerHTML = "â— Waking the marketâ€¦<div style='font-size:10px;color:var(--faint);margin-top:6px'>Loading live trending tokens from GMGN</div>";
  el.style.display = "block";
}
function showArenaEmpty(){
  const el = arenaHintEl();
  el.innerHTML = "â— No live tokens right now<div style='font-size:10px;color:var(--faint);margin-top:6px'>The market feed is quiet or waking. Pull to refresh in a moment.</div>";
  el.style.display = "block";
}
function hideArenaLoading(){
  const el = document.getElementById("arena-hint");
  if(el) el.style.display = "none";
}

// ===== WAR INTEL â€” pre-arena intelligence briefing =====
let INTEL_CARDS = [], INTEL_IDX = 0, INTEL_ENTERED = false;

function fmtUsd(n){ if(n==null) return "â€”"; const a=Math.abs(n);
  if(a>=1e9) return (n<0?"-":"")+"$"+(a/1e9).toFixed(2)+"B";
  if(a>=1e6) return (n<0?"-":"")+"$"+(a/1e6).toFixed(2)+"M";
  if(a>=1e3) return (n<0?"-":"")+"$"+(a/1e3).toFixed(1)+"K";
  return (n<0?"-":"")+"$"+Math.round(a); }
function fmtRoi(r){ if(r==null) return "â€”"; return r>=10 ? "+"+Math.round(r).toLocaleString()+"x" : "+"+Math.round(r*100)+"%"; }
function shortW(w){ return w && w.length>12 ? w.slice(0,5)+"â€¦"+w.slice(-4) : (w||"â€”"); }

function copyRow(label, value){
  if(!value) return "";
  const enc = encodeURIComponent(value);
  return "<div class='ic-copyrow' data-copy='"+enc+"' title='Tap to copy'>"
    + "<span class='ic-copyrow-k'>"+label+"</span>"
    + "<span class='ic-copyrow-v'>"+value+"</span>"
    + "<span class='ic-copyrow-tap'>â§‰</span></div>";
}

function intelCardHtml(c){
  const acc = c.type==="biggest_move" ? "var(--gold)" : (c.roiTier==="EXTREME_OUTLIER"?"var(--power)":"#9ec1ff");
  const glowCol = c.type==="biggest_move" ? "rgba(240,182,77,.35)" : (c.roiTier==="EXTREME_OUTLIER"?"rgba(240,120,60,.35)":"rgba(120,170,255,.35)");
  const title = {
    biggest_realized_profit:"â—† BIGGEST REALIZED PROFIT",
    biggest_realized_roi:"âš¡ BIGGEST REALIZED ROI",
    biggest_move:"â†— BIGGEST TOKEN MOVE",
    wallet_in_focus:"â—‰ WALLET IN FOCUS",
    repeat_performer:"â˜… REPEAT PERFORMER",
  }[c.type] || c.type;
  const symLabel = c.symbol ? "$"+c.symbol : (c.token?shortW(c.token):"");
  const tierChip = c.roiTier ? " <span class='ic-tier "+c.roiTier+"'>"+c.roiTier.replace(/_/g," ")+"</span>" : "";
  const pctTxt = (c.roiPct!=null) ? ((c.roiPct>=0?"+":"")+(Math.abs(c.roiPct)>=10000?Math.round(c.roiPct).toLocaleString():c.roiPct.toFixed(1))+"%") : null;
  let hero="", grid="";

  if(c.type==="biggest_move"){
    hero = "<div class='ic-big huge' style='color:"+acc+"'>+"+(c.priceChange1hPct!=null?c.priceChange1hPct.toFixed(1):"â€”")+"%</div>"
      + "<div class='ic-sym'>"+symLabel+"</div>";
    grid = "<div class='ic-grid'><div><div class='ic-cell-k'>WINDOW</div><div class='ic-cell-v'>1 HOUR</div></div>"
      + "<div><div class='ic-cell-k'>CHAIN</div><div class='ic-cell-v'>"+(c.chain||"").toUpperCase()+"</div></div></div>";
  } else if(c.type==="biggest_realized_roi"){
    hero = "<div class='ic-big huge' style='color:"+acc+"'>"+(pctTxt||fmtRoi(c.realizedRoi))+"</div>"
      + "<div class='ic-sym'>"+symLabel+tierChip+"</div>";
    grid = "<div class='ic-grid ic-grid-3'>"
      + "<div><div class='ic-cell-k'>ENTRY</div><div class='ic-cell-v'>"+fmtUsd(c.costUsd)+"</div></div>"
      + "<div><div class='ic-cell-k'>EXIT</div><div class='ic-cell-v' style='color:var(--green)'>"+fmtUsd(c.exitUsd)+"</div></div>"
      + "<div><div class='ic-cell-k'>PROFIT</div><div class='ic-cell-v' style='color:var(--green)'>"+fmtUsd(c.realizedProfitUsd)+"</div></div></div>";
  } else if(c.type==="repeat_performer"){
    hero = "<div class='ic-big huge' style='color:"+acc+"'>"+c.observations+"Ã—</div>"
      + "<div class='ic-sym'>REPEAT WINS"+tierChip+"</div>";
    grid = "<div class='ic-grid'><div><div class='ic-cell-k'>TOTAL REALIZED</div><div class='ic-cell-v' style='color:var(--green)'>"+fmtUsd(c.realizedProfitUsd)+"</div></div>"
      + "<div><div class='ic-cell-k'>TOKENS</div><div class='ic-cell-v'>"+(c.tokens||"â€”")+"</div></div></div>";
  } else { // profit / wallet_in_focus
    hero = "<div class='ic-big huge' style='color:var(--green)'>"+fmtUsd(c.realizedProfitUsd)+"</div>"
      + "<div class='ic-sym'>"+symLabel+tierChip+(pctTxt?" <span class='ic-pct'>"+pctTxt+"</span>":"")+"</div>";
    grid = "<div class='ic-grid ic-grid-3'>"
      + "<div><div class='ic-cell-k'>ENTRY</div><div class='ic-cell-v'>"+fmtUsd(c.costUsd)+"</div></div>"
      + "<div><div class='ic-cell-k'>EXIT</div><div class='ic-cell-v' style='color:var(--green)'>"+fmtUsd(c.exitUsd)+"</div></div>"
      + "<div><div class='ic-cell-k'>ROI</div><div class='ic-cell-v'>"+(pctTxt||"â€”")+"</div></div></div>";
  }

  // WALLET DNA â€” WAR's unique cross-token performance fingerprint.
  let dna = "";
  if(c.walletDna){
    const d = c.walletDna;
    const wr = d.winRate!=null ? Math.round(d.winRate*100)+"%" : "â€”";
    const badge = d.proven
      ? "<span class='dna-badge proven'>âœ“ PROVEN</span>"
      : "<span class='dna-badge new'>â—” "+d.seenCount+" SIGHTING"+(d.seenCount===1?"":"S")+"</span>";
    dna = "<div class='ic-dna'>"
      + "<div class='ic-dna-head'>â—ˆ WALLET DNA "+badge+"</div>"
      + "<div class='ic-dna-row'>"
      +   "<div class='dna-stat'><span class='dna-k'>WIN RATE</span><span class='dna-v'>"+wr+"</span></div>"
      +   "<div class='dna-stat'><span class='dna-k'>TOKENS</span><span class='dna-v'>"+d.tokensTraded+"</span></div>"
      +   "<div class='dna-stat'><span class='dna-k'>CONVICTION</span><span class='dna-v dna-c-"+d.conviction+"'>"+d.conviction+"</span></div>"
      + "</div></div>";
  }

  // Copyable identifiers â€” full wallet + token addresses.
  let copies = "";
  if(c.wallet) copies += copyRow("WALLET", c.wallet);
  if(c.token)  copies += copyRow("TOKEN", c.token);

  const follow = c.wallet
    ? "<div class='ic-follow'><button class='btn gold' onclick=\"intelFollow('"+c.chain+"','"+c.wallet+"')\">â—‰ WATCH THIS WALLET</button></div>"
    : "";

  return "<div class='intel-card'><div class='intel-card-glow' style='background:radial-gradient(circle,"+glowCol+",transparent 70%)'></div>"
    + "<div class='ic-type' style='color:"+acc+"'>"+title+"</div>"
    + hero + copies + grid + dna + follow + "</div>";
}

function intelCopy(btn){
  const value = decodeURIComponent(btn.getAttribute("data-copy") || "");
  if(!value) return;
  let ok = false;
  try {
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(value); ok = true; }
  } catch(e){}
  if(!ok){
    try {
      const t=document.createElement("textarea");
      t.value=value; t.style.position="fixed"; t.style.opacity="0"; t.style.top="0";
      document.body.appendChild(t); t.focus(); t.select();
      try { t.setSelectionRange(0, value.length); } catch(e){}
      ok = document.execCommand("copy"); t.remove();
    } catch(e){}
  }
  if(btn){
    btn.textContent = ok ? "âœ“ COPIED" : "COPY";
    btn.classList.add("done");
    setTimeout(()=>{ btn.textContent="COPY"; btn.classList.remove("done"); }, 1600);
  }
  try { if(TG && TG.HapticFeedback) TG.HapticFeedback.notificationOccurred(ok?"success":"error"); } catch(e){}
}

function intelRender(){
  const deck = document.getElementById("intel-deck");
  const dots = document.getElementById("intel-dots");
  if(!deck) return;
  if(!INTEL_CARDS.length){
    deck.innerHTML = "<div class='intel-empty'>â— INTELLIGENCE SYNCING<br><span style='font-size:10px;color:var(--faint)'>Live wallet performance is being gathered.<br>Enter the arena to begin.</span></div>";
    if(dots) dots.innerHTML=""; return;
  }
  deck.innerHTML = INTEL_CARDS.map(intelCardHtml).join("");
  const cards = deck.querySelectorAll(".intel-card");
  cards.forEach((el,i)=>{
    el.className = "intel-card";
    const rel = i - INTEL_IDX;
    if(rel < 0) el.classList.add("pos-out");
    else if(rel === 0) el.classList.add("pos-0");
    else if(rel === 1) el.classList.add("pos-1");
    else if(rel === 2) el.classList.add("pos-2");
    // rel > 2 stays hidden (default)
  });
  if(dots) dots.innerHTML = INTEL_CARDS.map((_,i)=>"<div class='dot"+(i===INTEL_IDX?" on":"")+"' onclick='intelJump("+i+")'></div>").join("");
}
function intelGo(dir){
  if(!INTEL_CARDS.length) return;
  const next = INTEL_IDX + dir;
  if(next < 0 || next >= INTEL_CARDS.length) return;
  INTEL_IDX = next;
  intelRender();
  try { if(TG && TG.HapticFeedback) TG.HapticFeedback.selectionChanged(); } catch(e){}
}
function intelJump(i){ if(i>=0 && i<INTEL_CARDS.length){ INTEL_IDX=i; intelRender(); } }
async function intelFollow(chain, wallet){
  // First check the user's current tier/quota, then either add or show plans.
  const status = await api("/wallet-watch");
  const used = (status.ok && status.used!=null) ? status.used : 0;
  const maxW = (status.ok && status.maxWallets!=null) ? status.maxWallets : 1;

  // Try to add the wallet.
  const r = await api("/wallet-watch", { method:"POST", body: JSON.stringify({ chain, walletAddress:wallet }) });
  if(r.ok){
    enterArena();               // leave the briefing
    goWatch();                  // open the Watch tab so they see it added
    safeAlert("âœ“ Now watching "+shortW(wallet)+" â€” you'll get buy/sell alerts.");
    return;
  }
  if(r.status===402 && r.error==="WALLET_QUOTA_REACHED"){
    // Not subscribed / quota full â†’ take them to the Watch tab where the tiers
    // are shown, so they can upgrade and then add the wallet.
    enterArena();
    goWatch();
    // stash the wallet so they can one-tap add after upgrading
    try { window.__pendingWatch = { chain, wallet }; } catch(e){}
    safeAlert("You're on "+ (r.tier||"FREE") +" ("+maxW+" wallet"+(maxW>1?"s":"")+"). Upgrade to watch this wallet â€” plans are shown here.");
    return;
  }
  if(r.status===402){ safeAlert("Insufficient balance â€” top up in My Account to subscribe."); return; }
  if(r.status===409 || r.needsConsent){ safeAlert("Please accept the terms first (reopen the app to see the consent screen), then try again."); return; }
  if(r.status===401){ safeAlert("Session not verified. Please reopen WAR from Telegram."); return; }
  if(r.status===400){ safeAlert("This wallet can't be watched (missing chain/address)."); return; }
  safeAlert("Could not watch this wallet (server said: "+(r.error||("HTTP "+r.status))+").");
}
function goWatch(){ const b=document.querySelector('.nav button[data-s="watch"]'); if(b) b.click(); }
async function intelLoad(){
  const r = await api("/war/intel");
  const status = document.getElementById("intel-status");
  if(r.ok && Array.isArray(r.cards) && r.cards.length){
    INTEL_CARDS = r.cards; INTEL_IDX = 0;
    if(status){
      const conf = r.calibration ? r.calibration.confidence : "";
      status.textContent = (r.cached?"â— RECENT INTEL":"â— LIVE INTEL") + (conf?" Â· "+conf+" CONFIDENCE":"");
    }
  } else {
    INTEL_CARDS = [];
    if(status) status.textContent = "â— INTELLIGENCE SYNCING";
  }
  intelRender();
}
function intelSetupSwipe(){
  const stage = document.getElementById("intel-stage");
  if(!stage) return;
  let x0=null, y0=null;
  stage.addEventListener("touchstart", e=>{ x0=e.touches[0].clientX; y0=e.touches[0].clientY; }, {passive:true});
  stage.addEventListener("touchend", e=>{
    if(x0==null) return;
    const dx=e.changedTouches[0].clientX-x0;
    const dy=e.changedTouches[0].clientY-y0;
    // Only switch cards on a clearly HORIZONTAL swipe; vertical gestures are
    // left to the card's internal scroll (so the Watch button is reachable).
    if(Math.abs(dx)>45 && Math.abs(dx) > Math.abs(dy)*1.4) intelGo(dx<0?1:-1);
    x0=null; y0=null;
  }, {passive:true});
  let mx=null, my=null;
  stage.addEventListener("mousedown", e=>{ mx=e.clientX; my=e.clientY; });
  stage.addEventListener("mouseup", e=>{
    if(mx==null) return;
    const dx=e.clientX-mx, dy=e.clientY-my;
    if(Math.abs(dx)>45 && Math.abs(dx) > Math.abs(dy)*1.4) intelGo(dx<0?1:-1);
    mx=null; my=null;
  });
}
function enterArena(){
  if(INTEL_ENTERED) return; INTEL_ENTERED=true;
  const ov = document.getElementById("intel-overlay");
  if(ov){ ov.classList.add("gone"); setTimeout(()=>{ ov.style.display="none"; }, 800); }
}

async function boot(){
  // WAR INTEL first: show the briefing immediately while the arena prepares.
  intelSetupSwipe();
  const enterBtn = document.getElementById("intel-enter");
  if(enterBtn) enterBtn.onclick = enterArena;
  intelLoad(); // fire-and-forget â€” cards appear as soon as they arrive
  // Always start arena in a live-loading state â€” never show fake demo tokens.
  showArenaLoading();
  const r = await api("/health");
  if(r.ok){
    const me = await api("/me");
    if(me.ok && me.profile){
      ACCT.balanceUsd = (me.profile.balanceMicros||0)/1e6;
      ACCT.freeScansRemaining = me.profile.freeScansRemaining ?? ACCT.freeScansRemaining;
      ACCT.tier = me.profile.tier || ACCT.tier;
      if(me.promotion) LIVE.promotion = me.promotion;
      if(me.membership) LIVE.membership = me.membership;
    }
  }
  // Load real trending regardless (retries handle a cold-started server).
  await loadTrending();
  renderPromoBanner();
  syncWallet(); renderAccount();
  maybeShowOnboarding();
}
document.body.setAttribute("data-screen","galaxy"); wwInit(); boot();
</script>
</body>
</html>


