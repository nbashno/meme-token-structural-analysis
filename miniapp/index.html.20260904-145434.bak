<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
<title>WAR ARENA</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');
  :root{
    --base:#060812; --void:#060812; --panel:rgba(18,26,46,.55); --panel2:rgba(28,38,60,.6); --line:rgba(139,160,200,.14);
    --ink:#eef2f8; --sub:#93a0b5; --faint:#5a6577;
    --power:#5b8cff; --cmd:#5b8cff; --threat:#ff5d6c; --gold:#f0b64d; --green:#4fd0a8; --sig:#4fd0a8;
    --mono:'DM Mono',ui-monospace,Menlo,monospace; --sans:'Space Grotesk',-apple-system,system-ui,sans-serif;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;height:100%;background:var(--base);color:var(--ink);font-family:var(--sans);overflow:hidden;-webkit-font-smoothing:antialiased}

  /* ===== AURORA MESH â€” living background ===== */
  .aurora{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
  body[data-screen="galaxy"] .aurora{opacity:0}
  .blob{position:absolute;border-radius:50%;filter:blur(80px);opacity:.5;mix-blend-mode:screen;will-change:transform}
  .b1{width:52vh;height:52vh;background:radial-gradient(circle,#2748d8,transparent 70%);top:-12vh;left:-8vh;animation:drift1 22s ease-in-out infinite}
  .b2{width:46vh;height:46vh;background:radial-gradient(circle,#0e7a5f,transparent 70%);bottom:-14vh;right:-10vh;animation:drift2 27s ease-in-out infinite}
  .b3{width:36vh;height:36vh;background:radial-gradient(circle,#7b2d8e,transparent 70%);top:40%;left:55%;animation:drift3 31s ease-in-out infinite}
  @keyframes drift1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(6vh,8vh) scale(1.15)}66%{transform:translate(-4vh,4vh) scale(.9)}}
  @keyframes drift2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-8vh,-6vh) scale(1.2)}}
  @keyframes drift3{0%,100%{transform:translate(0,0) scale(1)}40%{transform:translate(-7vh,5vh) scale(.85)}80%{transform:translate(5vh,-4vh) scale(1.1)}}
  @media (prefers-reduced-motion:reduce){.blob{animation:none}}

  /* screens */
  .screen{position:fixed;inset:0;display:none;flex-direction:column;overflow-y:auto;padding-bottom:66px}
  .screen.on{display:flex}
  canvas{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0}
  #gbg{z-index:0}#gl{z-index:1}
  /* arena canvases + labels show only on the galaxy screen */
  #gbg,#gl,#gLabels{opacity:0;transition:opacity .4s;pointer-events:none}
  body[data-screen="galaxy"] #gbg,body[data-screen="galaxy"] #gl{opacity:1}
  body[data-screen="galaxy"] #gl{pointer-events:auto}
  body[data-screen="galaxy"] #gLabels{opacity:1}
  .topbar{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:linear-gradient(var(--base),rgba(6,8,18,0))}
  .brand{font-family:var(--mono);font-weight:500;letter-spacing:.28em;font-size:14px;text-shadow:0 0 18px rgba(91,140,255,.5)}
  .wallet{font-family:var(--mono);font-size:11px;color:var(--gold);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:5px 11px;backdrop-filter:blur(14px)}
  /* bottom nav */
  .nav{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;background:rgba(10,14,26,.7);border-top:1px solid var(--line);backdrop-filter:blur(20px) saturate(1.3)}
  .nav button{flex:1;background:none;border:none;color:var(--faint);font-family:var(--mono);font-size:10px;padding:11px 0 13px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;transition:color .2s}
  .nav button.on{color:var(--power)}
  .nav .ic{font-size:17px}
  /* galaxy overlay labels */
  #gLabels{position:fixed;inset:0;z-index:1;pointer-events:none}
  .glbl{position:absolute;transform:translate(-50%,-50%);font-family:var(--mono);text-align:center;pointer-events:auto;cursor:pointer}
  .glhint{position:fixed;left:50%;bottom:74px;transform:translateX(-50%);z-index:3;font-family:var(--mono);font-size:10px;color:var(--faint);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:5px 13px;backdrop-filter:blur(14px)}
  /* data-mode badge â€” the single, always-visible truth about what the arena shows */
  .datamode{position:fixed;left:50%;top:16px;transform:translateX(-50%);z-index:4;font-family:var(--mono);font-size:10px;letter-spacing:.12em;font-weight:600;border-radius:16px;padding:5px 14px;backdrop-filter:blur(14px);opacity:0;transition:opacity .4s;pointer-events:none;white-space:nowrap}
  body[data-screen="galaxy"] .datamode{opacity:1}
  .datamode[data-mode="DEMO"]{color:#f0b64d;background:#f0b64d18;border:1px solid #f0b64d55}
  /* ===== WAR INTEL â€” tactical intelligence briefing ===== */
  #intel-overlay{position:fixed;inset:0;z-index:60;background:
    radial-gradient(ellipse at 50% 0%,rgba(91,140,255,.14),transparent 55%),
    radial-gradient(ellipse at 80% 90%,rgba(240,120,60,.12),transparent 50%),
    linear-gradient(180deg,#05070f,#0a0e1a 60%,#05070f);
    display:flex;flex-direction:column;align-items:center;overflow:hidden;
    opacity:1;transition:opacity .7s ease}
  #intel-overlay.gone{opacity:0;pointer-events:none}
  .intel-scanline{position:absolute;left:0;right:0;height:2px;top:0;
    background:linear-gradient(90deg,transparent,rgba(91,140,255,.6),transparent);
    animation:intelScan 4s linear infinite;pointer-events:none}
  @keyframes intelScan{0%{top:0;opacity:0}10%{opacity:1}90%{opacity:1}100%{top:100%;opacity:0}}
  .intel-head{text-align:center;margin-top:min(9vh,70px);padding:0 20px}
  .intel-brand{font-family:var(--mono);font-size:clamp(26px,7vw,40px);font-weight:700;letter-spacing:.18em;color:var(--ink);text-shadow:0 0 28px rgba(91,140,255,.5)}
  .intel-brand span{color:var(--power);margin-left:.15em}
  .intel-sub{font-family:var(--mono);font-size:10px;letter-spacing:.24em;color:var(--sub);margin-top:10px;opacity:.85}
  .intel-stage{flex:1;width:100%;display:flex;align-items:center;justify-content:center;position:relative;touch-action:pan-y;perspective:1400px}
  .intel-deck{position:relative;width:min(88vw,400px);height:min(60vh,470px);transform-style:preserve-3d}
  /* Liquid-glass card, stacked deck (cards fan behind the active one) */
  .intel-card{position:absolute;inset:0;border-radius:26px;padding:28px 26px;
    background:linear-gradient(160deg,rgba(28,36,58,.72),rgba(12,17,32,.86));
    backdrop-filter:blur(26px) saturate(150%);-webkit-backdrop-filter:blur(26px) saturate(150%);
    border:1px solid rgba(255,255,255,.1);
    box-shadow:0 30px 70px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.14),inset 0 -1px 0 rgba(0,0,0,.3);
    display:flex;flex-direction:column;overflow:hidden;
    transition:transform .55s cubic-bezier(.22,1,.36,1),opacity .5s ease;
    will-change:transform,opacity}
  /* Active card: content scrolls vertically so the Watch button is always
     reachable even when DNA + grid make the card tall. Vertical pan is for
     scrolling; horizontal swipe (handled in JS) still switches cards. */
  .intel-card.pos-0{overflow-y:auto;-webkit-overflow-scrolling:touch}
  .intel-card::-webkit-scrollbar{width:4px}
  .intel-card::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:2px}
  /* subtle scroll cue at the bottom of the active card */
  .intel-card.pos-0::after{content:"";position:sticky;bottom:0;left:0;right:0;height:20px;
    margin-top:-20px;background:linear-gradient(transparent,rgba(12,17,32,.6));pointer-events:none;flex:0 0 auto}
  /* iridescent top edge (liquid-glass signature) */
  .intel-card::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,rgba(120,170,255,.7),rgba(240,140,90,.6),transparent);opacity:.8}
  /* stacked positions: active front, others fanned behind with depth */
  .intel-card{opacity:0;transform:translateY(60px) scale(.9);pointer-events:none;z-index:0}
  .intel-card.pos-0{opacity:1;transform:translateY(0) scale(1) rotateX(0);pointer-events:auto;z-index:5}
  .intel-card.pos-1{opacity:.55;transform:translateY(-16px) scale(.94);z-index:4}
  .intel-card.pos-2{opacity:.28;transform:translateY(-30px) scale(.88);z-index:3}
  .intel-card.pos-out{opacity:0;transform:translateX(-120%) rotate(-8deg) scale(.9);z-index:6}
  .intel-card-glow{position:absolute;top:-35%;right:-30%;width:300px;height:300px;border-radius:50%;filter:blur(20px);pointer-events:none;opacity:.6;animation:icPulse 6s ease-in-out infinite}
  @keyframes icPulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:.75;transform:scale(1.08)}}
  .ic-type{font-family:var(--mono);font-size:10px;letter-spacing:.2em;font-weight:600;margin-bottom:20px;position:relative;display:flex;align-items:center;gap:8px}
  .ic-type::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,currentColor,transparent);opacity:.3}
  .ic-big{font-family:var(--mono);font-weight:700;line-height:.95;position:relative;margin-bottom:8px;letter-spacing:-.02em}
  .ic-big.huge{font-size:clamp(44px,13vw,68px);text-shadow:0 0 40px currentColor}
  .ic-sym{font-size:clamp(19px,5.5vw,26px);font-weight:700;color:var(--ink);position:relative;margin-bottom:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .ic-copyrow{display:flex;align-items:center;gap:7px;position:relative;margin-bottom:6px;
    background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.07);border-radius:10px;padding:9px 11px}
  .ic-copyrow-k{font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:var(--faint);flex:0 0 auto}
  .ic-copyrow-v{font-family:var(--mono);font-size:11px;color:var(--sub);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ic-copyrow-tap{flex:0 0 auto;color:#9ec1ff;font-size:13px;opacity:.7}
  .ic-copybtn{flex:0 0 auto;background:rgba(120,170,255,.12);border:1px solid rgba(120,170,255,.3);color:#9ec1ff;
    border-radius:7px;padding:5px 9px;font-family:var(--mono);font-size:9px;cursor:pointer;transition:all .15s}
  .ic-copybtn:active{transform:scale(.92);background:rgba(120,170,255,.25)}
  .ic-copybtn.done{background:rgba(79,208,168,.2);border-color:rgba(79,208,168,.5);color:#4fd0a8}
  .ic-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;position:relative;margin-top:auto;padding-top:18px}
  .ic-grid-3{grid-template-columns:1fr 1fr 1fr;gap:10px}
  .ic-pct{font-family:var(--mono);font-size:13px;color:var(--green);font-weight:600;background:rgba(79,208,168,.12);border:1px solid rgba(79,208,168,.3);border-radius:6px;padding:2px 8px}
  /* WALLET DNA â€” WAR's unique cross-token fingerprint */
  .ic-dna{margin-top:16px;padding:14px;border-radius:14px;position:relative;
    background:linear-gradient(135deg,rgba(120,90,240,.14),rgba(91,140,255,.08));
    border:1px solid rgba(140,110,255,.28)}
  .ic-dna-head{font-family:var(--mono);font-size:9px;letter-spacing:.14em;color:#b9a5ff;font-weight:600;margin-bottom:11px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .dna-badge{font-family:var(--mono);font-size:8px;letter-spacing:.08em;padding:3px 8px;border-radius:5px}
  .dna-badge.proven{color:#4fd0a8;background:rgba(79,208,168,.16);border:1px solid rgba(79,208,168,.45)}
  .dna-badge.new{color:var(--gold);background:rgba(240,182,77,.12);border:1px solid rgba(240,182,77,.35)}
  .ic-dna-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
  .dna-stat{display:flex;flex-direction:column;gap:3px}
  .dna-k{font-family:var(--mono);font-size:7px;letter-spacing:.1em;color:var(--faint)}
  .dna-v{font-family:var(--mono);font-size:13px;color:var(--ink);font-weight:600}
  .dna-c-WHALE{color:#ff9c5c}.dna-c-SERIOUS{color:#4fd0a8}.dna-c-MODERATE{color:#9ec1ff}.dna-c-SMALL{color:var(--sub)}.dna-c-UNKNOWN{color:var(--faint)}
  .ic-cell-k{font-family:var(--mono);font-size:8px;letter-spacing:.14em;color:var(--faint)}
  .ic-cell-v{font-family:var(--mono);font-size:16px;color:var(--ink);margin-top:4px;font-weight:600}
  .ic-tier{display:inline-block;font-family:var(--mono);font-size:8px;letter-spacing:.1em;padding:4px 9px;border-radius:6px;font-weight:600}
  .ic-tier.EXTREME_OUTLIER{color:#ff9c5c;background:rgba(240,120,60,.16);border:1px solid rgba(240,120,60,.45);box-shadow:0 0 16px rgba(240,120,60,.25)}
  .ic-tier.HIGH{color:#4fd0a8;background:rgba(79,208,168,.14);border:1px solid rgba(79,208,168,.4)}
  .ic-tier.SOLID{color:#9ec1ff;background:rgba(120,170,255,.14);border:1px solid rgba(120,170,255,.4)}
  .ic-tier.MODEST{color:var(--sub);background:rgba(255,255,255,.06);border:1px solid var(--line)}
  .ic-follow{margin-top:18px;position:relative}
  .ic-follow .btn{width:100%;padding:14px;font-size:12px;letter-spacing:.06em}
  .intel-dots{display:flex;gap:9px;margin:18px 0}
  .intel-dots .dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.16);transition:all .4s cubic-bezier(.22,1,.36,1);cursor:pointer}
  .intel-dots .dot.on{background:linear-gradient(90deg,var(--power),var(--gold));width:26px;border-radius:4px;box-shadow:0 0 12px rgba(240,140,70,.5)}
  .intel-enter{margin-bottom:min(6vh,44px);background:linear-gradient(90deg,var(--power),var(--gold));color:#0a0e1a;
    font-family:var(--mono);font-size:13px;font-weight:700;letter-spacing:.1em;border:none;border-radius:14px;
    padding:16px 46px;cursor:pointer;box-shadow:0 8px 34px rgba(240,140,70,.45);transition:transform .25s cubic-bezier(.22,1,.36,1),box-shadow .25s}
  .intel-enter:hover{transform:translateY(-3px);box-shadow:0 14px 44px rgba(240,140,70,.6)}
  .intel-enter:active{transform:translateY(-1px) scale(.98)}
  .intel-empty{font-family:var(--mono);font-size:12px;color:var(--sub);text-align:center;padding:40px;line-height:1.8}
  .intel-hint{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--faint);margin-top:-6px;margin-bottom:6px}
  .datamode[data-mode="LIVE-TOKENS"]{color:#f0b64d;background:#f0b64d14;border:1px solid #f0b64d44}
  .datamode[data-mode="LIVE"]{color:#4fd0a8;background:#4fd0a814;border:1px solid #4fd0a855}
  /* content */
  .wrap{position:relative;z-index:2;padding:0 14px}

  /* ===== GLASS CARD ===== */
  .glass,.card{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;margin:12px 0;
    backdrop-filter:blur(24px) saturate(1.3);-webkit-backdrop-filter:blur(24px) saturate(1.3);
    box-shadow:0 8px 40px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.06);overflow:hidden}
  .glass.sc{animation:rise .6s cubic-bezier(.2,.8,.2,1) backwards}
  .glass.sc:nth-child(1){animation-delay:.02s}.glass.sc:nth-child(2){animation-delay:.08s}.glass.sc:nth-child(3){animation-delay:.14s}.glass.sc:nth-child(4){animation-delay:.2s}.glass.sc:nth-child(5){animation-delay:.26s}.glass.sc:nth-child(6){animation-delay:.32s}.glass.sc:nth-child(7){animation-delay:.38s}.glass.sc:nth-child(8){animation-delay:.44s}
  @keyframes rise{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
  .glass::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(91,140,255,.5),transparent)}
  .eyebrow,.card-t{font-family:var(--mono);font-size:9px;letter-spacing:.22em;color:var(--faint);text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px}
  .eyebrow::after{content:'';flex:1;height:1px;background:var(--line)}

  /* token header */
  .token{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px}
  .sym{font-size:26px;font-weight:700;letter-spacing:-.02em}
  .addr{font-family:var(--mono);font-size:10px;color:var(--faint)}
  .moodline{font-family:var(--mono);font-size:13px;letter-spacing:.14em;margin-bottom:16px}
  /* state badges */
  .states{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .sbadge{background:rgba(0,0,0,.22);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
  .sk{font-family:var(--mono);font-size:8px;letter-spacing:.14em;color:var(--faint)}
  .sv{font-family:var(--mono);font-size:12px;font-weight:500;margin-top:2px}
  /* liquidity */
  .liq{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
  .lcol{border-radius:13px;padding:13px;border:1px solid var(--line)}
  .lcol.in{background:linear-gradient(160deg,rgba(79,208,168,.12),transparent)}
  .lcol.out{background:linear-gradient(160deg,rgba(255,93,108,.12),transparent)}
  .llab{font-family:var(--mono);font-size:9px;letter-spacing:.1em;margin-bottom:5px}
  .lval{font-size:19px;font-weight:700}
  .lmeta{font-family:var(--mono);font-size:10px;color:var(--faint);margin-top:2px}
  .net{text-align:center;font-family:var(--mono);font-size:12px;padding:9px;border-radius:10px;background:rgba(0,0,0,.25);color:var(--sub)}
  /* forces */
  .forces{display:grid;gap:13px}
  .f{display:grid;grid-template-columns:82px 1fr 66px;align-items:center;gap:10px}
  .fl{font-family:var(--mono);font-size:10px;color:var(--sub);letter-spacing:.06em}
  .ftrk{height:6px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden;position:relative}
  .ffill{position:absolute;inset:0 auto 0 0;border-radius:3px;transform-origin:left;animation:fill 1.1s cubic-bezier(.2,.8,.2,1) backwards}
  @keyframes fill{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .fv{font-family:var(--mono);font-size:13px;font-weight:500;text-align:right}
  .fband{display:block;font-size:8px;color:var(--faint);letter-spacing:.08em}
  /* flow entities */
  .flowlist{display:grid;gap:8px}
  .flowunavail{font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--faint);text-align:center;padding:16px 10px}
  .flowunavail .fusub{font-size:10px;letter-spacing:0;color:var(--faint);opacity:.75;margin-top:7px;line-height:1.5}
  .frow{display:grid;grid-template-columns:20px 1fr auto auto;align-items:center;gap:9px;font-family:var(--mono);font-size:11px}
  .fside{font-size:10px}.fside.buy{color:var(--sig)}.fside.sell{color:var(--threat)}
  .fmaker{color:var(--sub)}
  .flane{font-size:8px;letter-spacing:.08em;border:1px solid;border-radius:5px;padding:2px 6px}
  .famt{font-weight:500;text-align:right}
  /* simulated-flow labelling â€” must never blur with live on-chain data */
  .simtag{font-size:7px;letter-spacing:.1em;color:#f0b64d;border:1px solid #f0b64d55;border-radius:4px;padding:1px 4px;margin-left:7px;vertical-align:middle;background:#f0b64d14}
  .eyebrow.simhead{color:#f0b64d}
  .glass.simcard{border-color:#f0b64d33;box-shadow:inset 0 0 0 1px #f0b64d1a}
  /* events */
  .events{display:grid;gap:10px}
  .erow{border-left:2px solid var(--line);padding-left:11px}
  .etype{font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--ink);display:flex;align-items:center;gap:8px}
  .eimp{font-size:8px;color:var(--gold);border:1px solid rgba(240,182,77,.4);border-radius:4px;padding:1px 5px}
  .ereason{font-size:12px;color:var(--sub);margin-top:3px}
  .sigs{display:flex;flex-wrap:wrap;gap:7px}
  .sig{font-family:var(--mono);font-size:10px;color:var(--sub);background:rgba(0,0,0,.22);border:1px solid var(--line);border-radius:6px;padding:4px 9px}
  .sig b{color:var(--cmd);font-weight:500}
  /* why now */
  .why{font-size:13px;color:var(--sub);line-height:1.6;margin:7px 0}
  /* data quality */
  .qpill{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.1em;border:1px solid;border-radius:20px;padding:5px 13px}
  .qreasons{font-family:var(--mono);font-size:10px;color:var(--faint);margin-top:10px;line-height:1.7}
  .insuf{border-color:rgba(240,182,77,.35)!important}
  .ins{display:inline-block;font-family:var(--mono);font-size:10px;color:var(--gold);background:rgba(240,182,77,.1);border:1px solid rgba(240,182,77,.3);border-radius:6px;padding:3px 9px;margin:3px 4px 0 0}
  .empty{font-family:var(--mono);font-size:11px;color:var(--faint)}
  /* wallet watch */
  .wintro{background:linear-gradient(180deg,rgba(91,140,255,.1),var(--panel2));border-color:rgba(91,140,255,.25)}
  .weyebrow{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--cmd);margin-bottom:7px}
  .wpitch{font-size:13px;line-height:1.55;color:var(--sub)}.wpitch b{color:var(--ink)}
  .wtiers{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;margin-top:13px}
  .wtier{background:rgba(0,0,0,.22);border:1px solid var(--line);border-radius:10px;padding:10px 7px;text-align:center;cursor:pointer;transition:all .15s}
  .wtier.on{border-color:var(--cmd);background:rgba(91,140,255,.1)}
  .wtier-name{font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--ink);font-weight:600}
  .wtier-price{font-family:var(--mono);font-size:13px;color:var(--power);margin:4px 0}
  .wtier-max{font-family:var(--mono);font-size:8px;color:var(--faint);letter-spacing:.05em}
  .wtier.current{border-color:#4fd0a8}.wtier.current .wtier-name{color:#4fd0a8}
  .wquota{font-family:var(--mono);font-size:10px;color:var(--faint);margin-bottom:10px}
  .wfield{margin-bottom:12px}
  .winput{width:100%;box-sizing:border-box;background:rgba(0,0,0,.25);border:1px solid var(--line);border-radius:10px;padding:12px 13px;color:var(--ink);font-family:var(--mono);font-size:12px;margin-bottom:9px}
  .winput:focus{outline:none;border-color:var(--cmd)}
  .wchains{display:flex;gap:6px}
  .wchip{flex:1;background:rgba(0,0,0,.2);border:1px solid var(--line);border-radius:8px;padding:8px 0;color:var(--faint);font-family:var(--mono);font-size:10px;letter-spacing:.06em;cursor:pointer;transition:all .15s}
  .wchip.on{color:var(--power);border-color:var(--power);background:rgba(255,120,90,.08)}
  .wbtns{display:flex;gap:8px}.wbtns .btn{flex:1}
  .btn.ghost{background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--sub)}
  .wrep{margin-top:12px;padding:12px;border-radius:10px;border:1px solid var(--line);background:rgba(0,0,0,.2)}
  .wrep-verdict{font-family:var(--mono);font-size:13px;letter-spacing:.1em;font-weight:600;margin-bottom:8px}
  .wrep-v-ELITE{color:#4fd0a8}.wrep-v-STRONG{color:var(--sig)}.wrep-v-MIXED{color:var(--gold)}.wrep-v-WEAK{color:var(--threat)}.wrep-v-INSUFFICIENT{color:var(--faint)}
  .wrep-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .wrep-cell{font-family:var(--mono);font-size:11px}.wrep-k{color:var(--faint);font-size:9px;letter-spacing:.1em}.wrep-val{color:var(--ink);font-size:14px}
  .wwrow{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--line)}
  .wwrow:last-child{border-bottom:none}
  .wwaddr{font-family:var(--mono);font-size:11px;color:var(--ink)}.wwmeta{font-family:var(--mono);font-size:9px;color:var(--faint)}
  .wwrow-l{min-width:0;flex:1}
  .wwrow-acts{display:flex;gap:6px;align-items:center;flex:0 0 auto}
  /* Token search suggestions */
  .search-results{display:none;margin-top:8px;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:rgba(0,0,0,.3)}
  .search-results.open{display:block}
  .sr-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 13px;cursor:pointer;border-bottom:1px solid var(--line);transition:background .15s}
  .sr-item:last-child{border-bottom:none}
  .sr-item:hover,.sr-item:active{background:rgba(91,140,255,.1)}
  .sr-sym{font-family:var(--mono);font-size:13px;color:var(--ink);font-weight:600}
  .sr-addr{font-family:var(--mono);font-size:9px;color:var(--faint)}
  .sr-chain{font-family:var(--mono);font-size:8px;letter-spacing:.08em;color:var(--sig);border:1px solid rgba(91,140,255,.3);border-radius:5px;padding:3px 7px;flex:0 0 auto}
  .sr-empty{padding:14px;font-family:var(--mono);font-size:11px;color:var(--faint);text-align:center}
  .ww-validate{font-family:var(--mono);font-size:10px;margin-top:7px;line-height:1.4;min-height:14px}
  .ww-validate.ok{color:#4fd0a8}.ww-validate.bad{color:var(--threat)}
  .chain-detected{font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:var(--faint);margin-bottom:10px;min-height:14px;transition:color .2s}
  .chain-detected.ok{color:#4fd0a8}.chain-detected.bad{color:var(--threat)}
  /* Universal click-to-copy affordance */
  [data-copy]{cursor:pointer;position:relative;transition:opacity .15s}
  [data-copy]:hover{opacity:.75}
  [data-copy].copied-flash{opacity:1}
  .copied-tip{position:absolute;left:50%;top:-24px;transform:translateX(-50%);white-space:nowrap;
    background:rgba(79,208,168,.95);color:#04120c;font-family:var(--mono);font-size:9px;font-weight:600;
    padding:3px 8px;border-radius:6px;z-index:80;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.4)}
  .wwcancel{background:none;border:1px solid var(--line);color:var(--faint);border-radius:7px;padding:5px 10px;font-family:var(--mono);font-size:9px;cursor:pointer}
  .afeed{display:grid;gap:8px}
  .arow{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;padding:10px;border-radius:9px;background:rgba(0,0,0,.2);border:1px solid var(--line)}
  .arow.conv{border-color:rgba(91,140,255,.4);background:rgba(91,140,255,.08)}
  .arow.dump{border-color:rgba(240,90,90,.4);background:rgba(240,90,90,.08)}
  .aicon{font-size:15px}.atext{font-size:11px;line-height:1.5;color:var(--sub)}.atext b{color:var(--ink)}
  .atime{font-family:var(--mono);font-size:8px;color:var(--faint);margin-top:3px}
  /* statistics section */
  .sgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
  .stile{background:rgba(0,0,0,.22);border:1px solid var(--line);border-radius:11px;padding:11px 10px}
  .sklab{font-family:var(--mono);font-size:8px;letter-spacing:.1em;color:var(--faint);margin-bottom:4px}
  .skval{font-family:var(--mono);font-size:15px;font-weight:500;color:var(--ink)}
  .safebar{height:8px;border-radius:4px;background:rgba(255,255,255,.06);overflow:hidden;margin-bottom:9px}
  .safefill{height:100%;border-radius:4px;transform-origin:left;animation:fill 1s cubic-bezier(.2,.8,.2,1)}
  .saferow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
  .safenote{font-family:var(--mono);font-size:10px;color:var(--sub)}
  .sderiv{display:grid;gap:8px}
  .dtile{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--sub);padding:8px 11px;background:rgba(0,0,0,.2);border-radius:9px}
  .dtile b{font-family:var(--mono);font-weight:500;font-size:12px}
  .disc{font-size:10px;color:var(--faint);line-height:1.5;margin-top:11px;padding-top:10px;border-top:1px solid var(--line)}
  /* WAR engine header (Analysis screen) */
  .warhead{background:linear-gradient(160deg,rgba(91,140,255,.10),rgba(79,208,168,.05));border:1px solid rgba(91,140,255,.25);border-radius:14px;padding:14px 15px;margin-bottom:12px}
  .warhead-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
  .warhead-badge{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.12em;color:var(--cmd)}
  .warhead-tag{font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:var(--faint)}
  .warhead-body{font-size:12px;color:var(--sub);line-height:1.6}
  .warhead-body b{color:var(--ink)}
  .warhead-note{font-size:11px;color:var(--faint);line-height:1.55;margin-top:9px;padding-top:9px;border-top:1px solid var(--line)}
  .warhead-note b{color:var(--gold)}
  .wartop{display:flex;gap:16px;align-items:center}
  .wgauge{flex:0 0 80px;position:relative;width:80px;height:80px}
  .wgring{animation:wgfill 1.1s cubic-bezier(.2,.8,.2,1)}
  @keyframes wgfill{from{stroke-dasharray:0 999}}
  .wgcenter{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .wgnum{font-family:var(--mono);font-size:24px;font-weight:500;line-height:1}
  .wglab{font-family:var(--mono);font-size:8px;color:var(--faint);margin-top:1px}
  .warverd{flex:1}
  .wsband{font-family:var(--mono);font-size:14px;letter-spacing:.14em;font-weight:500}
  .wslab2{font-family:var(--mono);font-size:8px;letter-spacing:.18em;color:var(--faint);margin:2px 0 6px}
  .wstext{font-size:12px;color:var(--sub);line-height:1.55}
  /* WAR SIGNATURE â€” the structural identity chips (the hero, not the number) */
  .wsig{display:flex;flex-wrap:wrap;gap:5px;margin-top:2px}
  .sigchip{font-family:var(--mono);font-size:9px;letter-spacing:.08em;font-weight:600;color:var(--cmd);background:rgba(91,140,255,.12);border:1px solid rgba(91,140,255,.35);border-radius:6px;padding:3px 7px}
  /* WAR card token identity â€” symbol + full copyable contract address */
  .wtoken{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:13px;padding-top:12px;border-top:1px solid var(--line)}
  .wtoken-sym{font-family:var(--sans);font-size:16px;font-weight:700;letter-spacing:-.01em;color:var(--ink)}
  .wtoken-chain{font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:var(--sub);background:rgba(91,140,255,.1);border:1px solid rgba(91,140,255,.3);border-radius:5px;padding:2px 7px}
  .wtoken-addr{font-family:var(--mono);font-size:10px;color:var(--sub);flex:1 1 100%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:8px 10px}
  .wtoken-addr:hover{color:var(--ink);border-color:rgba(120,170,255,.3)}
  .covfull{color:var(--green)}.covpartial{color:var(--gold)}
  .partialbar{font-family:var(--mono);font-size:10px;color:var(--gold);background:rgba(240,182,77,.1);border:1px solid rgba(240,182,77,.3);border-radius:9px;padding:7px 11px;margin-top:11px;line-height:1.45}
  .rugwarn{font-family:var(--mono);font-size:11px;color:#ff6b6b;background:rgba(240,60,60,.12);border:1px solid rgba(240,60,60,.45);border-radius:9px;padding:9px 12px;margin-top:11px;line-height:1.5;font-weight:600}
  /* WAR Founder Wallet â€” public identity card */
  .fwcard{border-color:rgba(120,140,180,.28)}
  /* Referral card â€” gamified, WAR battle aesthetic */
  .refcard{position:relative;overflow:hidden;border-color:rgba(240,120,60,.35);background:linear-gradient(160deg,rgba(240,120,60,.1),rgba(91,140,255,.06),var(--panel2))}
  .refglow{position:absolute;top:-40%;right:-20%;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(240,140,70,.25),transparent 70%);pointer-events:none;filter:blur(8px)}
  .refeyebrow{position:relative;font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--power);font-weight:600;margin-bottom:8px}
  .reftitle{position:relative;font-size:16px;font-weight:600;color:var(--ink);line-height:1.35;margin-bottom:6px}
  .refsub{position:relative;font-size:12px;line-height:1.55;color:var(--sub);margin-bottom:16px}
  .refprogress{position:relative;margin-bottom:16px}
  .refprogress-bar{height:10px;background:rgba(0,0,0,.35);border-radius:6px;overflow:hidden;border:1px solid var(--line)}
  .refprogress-fill{height:100%;width:0%;border-radius:6px;background:linear-gradient(90deg,var(--power),var(--gold));transition:width .6s cubic-bezier(.4,0,.2,1);box-shadow:0 0 12px rgba(240,140,70,.5)}
  .refprogress-label{font-family:var(--mono);font-size:10px;color:var(--sub);margin-top:8px;text-align:center}
  .refprogress-label span{color:var(--gold);font-weight:600}
  .refstats{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
  .refstat{background:rgba(0,0,0,.25);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center}
  .refstat-num{font-family:var(--mono);font-size:22px;font-weight:600;color:var(--power)}
  .refstat-lbl{font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:var(--faint);margin-top:3px}
  .reflink{position:relative;display:flex;gap:8px;align-items:center}
  .reflink-input{flex:1;background:rgba(0,0,0,.3);border:1px solid var(--line);border-radius:9px;padding:11px 12px;color:var(--sub);font-family:var(--mono);font-size:10px;overflow:hidden;text-overflow:ellipsis}
  .reflink-btn{flex:0 0 auto;padding:11px 20px}
  .fweyebrow{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--sub);margin-bottom:6px}
  .fwident{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--cmd);margin-bottom:8px}
  .fwfollow{display:flex;align-items:center;gap:12px;margin-bottom:14px}
  .fwfollow .btn{padding:8px 22px;flex:0 0 auto}
  .fwfollow .btn.following{background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--sub)}
  .fwcount{font-family:var(--mono);font-size:11px;color:var(--faint)}.fwcount span{color:var(--ink);font-size:14px}
  .fwsub{font-size:12px;line-height:1.5;color:var(--faint);margin-bottom:14px}
  .fwrow{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
  .fwrow:last-of-type{border-bottom:none}
  .fwrow-l{min-width:64px}
  .fwlabel{font-family:var(--mono);font-size:11px;color:var(--ink);font-weight:600}
  .fwchains{font-family:var(--mono);font-size:8px;letter-spacing:.06em;color:var(--faint);margin-top:2px}
  .fwaddr{font-family:var(--mono);font-size:11px;color:var(--sub);word-break:break-all}
  .fwacts{display:flex;gap:6px}
  .fwbtn{background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--sub);border-radius:7px;padding:5px 10px;font-family:var(--mono);font-size:9px;cursor:pointer;text-decoration:none;white-space:nowrap}
  .fwbtn:hover{border-color:var(--cmd);color:var(--ink)}
  .fwsafety{margin-top:13px;padding-top:12px;border-top:1px solid var(--line);display:grid;gap:6px}
  .fwsafe-line{font-size:10px;line-height:1.45;color:var(--faint)}.fwsafe-line b{color:var(--sub)}
  /* WHY WAR â€” split rationale, + strengths / âˆ’ risks */
  .whybox{display:grid;gap:5px}
  .whyrow{display:grid;grid-template-columns:16px auto 1fr;gap:8px;align-items:baseline;font-size:11px;line-height:1.5}
  .whysign{font-family:var(--mono);font-weight:700;text-align:center}
  .whyrow.pos .whysign{color:var(--green)}.whyrow.neg .whysign{color:var(--threat)}
  .whylab{font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:var(--ink);white-space:nowrap}
  .whyread{color:var(--sub)}
  /* MARKET CONTEXT â€” now */
  .ctxgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
  .ctxcell{background:rgba(0,0,0,.2);border:1px solid var(--line);border-radius:10px;padding:9px 6px;text-align:center}
  .ctxk{font-family:var(--mono);font-size:8px;letter-spacing:.16em;color:var(--faint);margin-bottom:4px}
  .ctxv{font-family:var(--mono);font-size:14px;font-weight:500}
  /* FORCES vs THREATS headers */
  .eyebrow.forcehead{color:var(--green)}
  .eyebrow.threathead{color:var(--threat)}
  .wfinds{display:grid;gap:6px}
  .wfind{font-size:12px;color:var(--sub);line-height:1.55}
  .widx{display:grid;gap:9px}
  .wrow{background:rgba(0,0,0,.2);border:1px solid var(--line);border-radius:11px;padding:10px 12px;cursor:pointer;transition:border-color .2s}
  .wrow:hover{border-color:rgba(91,140,255,.35)}
  .wrhead{display:flex;justify-content:space-between;align-items:baseline}
  .wrlab{font-size:12px;color:var(--ink)}
  .wrval{font-family:var(--mono);font-size:14px;font-weight:500;display:flex;align-items:baseline;gap:7px}
  .wrband{font-size:7px;letter-spacing:.12em;opacity:.75}
  .wrtrk{height:5px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden;margin:7px 0 5px}
  .wrfill{height:100%;border-radius:3px;transform-origin:left;animation:fill .9s cubic-bezier(.2,.8,.2,1)}
  .wrmeta{font-family:var(--mono);font-size:10px;color:var(--faint)}
  .wrdet{display:none;margin-top:9px;padding-top:9px;border-top:1px solid var(--line)}
  .wrow.open .wrdet{display:block}
  .wrread{font-size:12px;color:var(--sub);line-height:1.55;margin-bottom:6px}
  .wrform{font-family:var(--mono);font-size:10px;color:var(--faint);line-height:1.5}
  .wrform b{color:var(--sub)}
  .slinks{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
  .slink{font-family:var(--mono);font-size:11px;color:var(--cmd);text-decoration:none;border:1px solid var(--cmd);border-radius:8px;padding:6px 12px;transition:all .2s}
  .slink:hover{background:rgba(91,140,255,.15)}
  .dtile b.mono{font-family:var(--mono)}
  /* CTA */
  .cta{width:100%;padding:14px;border:none;border-radius:13px;font-family:var(--sans);font-weight:600;font-size:15px;cursor:pointer;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--cmd),#3a6de0);color:#04122e;box-shadow:0 6px 24px rgba(91,140,255,.35);transition:transform .2s}
  .cta:hover{transform:translateY(-2px)}
  .cta.gold{background:linear-gradient(135deg,var(--gold),#d99a2b);color:#2a1c04;box-shadow:0 6px 24px rgba(240,182,77,.3)}
  .searchbar{display:flex;gap:8px;margin:6px 0 2px}
  .searchbar input{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:10px;color:var(--ink);padding:11px 13px;font-family:var(--mono);font-size:13px;direction:ltr;text-align:left}
  .btn{background:var(--power);color:#04122e;border:none;border-radius:10px;padding:11px 16px;font-weight:700;font-size:14px;cursor:pointer;font-family:var(--sans)}
  .btn.ghost{background:var(--panel2);color:var(--ink);border:1px solid var(--line)}
  .btn.gold{background:var(--gold);color:#2e2204}
  .btn:active{transform:scale(.97)}
  .btn:disabled{opacity:.5}
  .liq{display:flex;gap:9px;margin-bottom:10px}
  .liqcol{flex:1;text-align:center;padding:11px 6px;border-radius:10px}
  .liqcol.in{background:rgba(79,208,168,.1);border:1px solid rgba(79,208,168,.3)}
  .liqcol.out{background:rgba(255,93,108,.1);border:1px solid rgba(255,93,108,.3)}
  .liqlab{font-family:var(--mono);font-size:9px;letter-spacing:.08em}
  .liqval{font-family:var(--mono);font-size:17px;font-weight:700;margin-top:4px}
  .forces{display:grid;grid-template-columns:1fr 1fr;gap:11px 14px}
  .f .l{font-family:var(--mono);font-size:9px;color:var(--sub);text-transform:uppercase}
  .f .n{font-size:20px;font-weight:700}
  .trk{height:4px;border-radius:2px;background:var(--panel2);margin-top:5px;overflow:hidden}.trk>span{display:block;height:100%}
  .lock{text-align:center;padding:26px 16px}
  .lock .big{font-size:34px;margin-bottom:8px}
  .row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(120,140,180,.08);font-family:var(--mono);font-size:13px}
  .row:last-child{border-bottom:none}
  .tier{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.1em;padding:4px 11px;border-radius:14px;border:1px solid var(--gold);color:var(--gold);margin-top:6px}
  .pack{display:flex;justify-content:space-between;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:13px 15px;margin:9px 0;cursor:pointer}
  .pack.command{border-color:var(--gold);background:linear-gradient(180deg,rgba(240,182,77,.08),var(--panel2))}
  .pack .p{font-family:var(--mono);font-size:16px;font-weight:700}
  .pack .b{font-family:var(--mono);font-size:10px;color:var(--green)}
  .big-num{font-family:var(--mono);font-size:28px;font-weight:700}
  .muted{color:var(--faint);font-family:var(--mono);font-size:10px}
  .chip{display:inline-block;font-family:var(--mono);font-size:9px;padding:3px 8px;border-radius:4px;border:1px solid var(--line);color:var(--sub);margin:2px 3px 2px 0}
  .banner{margin:10px 14px;padding:9px 12px;border-radius:10px;background:rgba(240,182,77,.08);border:1px solid rgba(240,182,77,.3);font-size:11px;color:var(--gold);font-family:var(--mono);text-align:center}
  .chainBtn{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:9px;color:var(--faint);padding:9px 0;font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.05em;cursor:pointer;transition:all .15s}
  .chainBtn.on{background:rgba(91,140,255,.16);border-color:var(--power);color:var(--power)}
</style>
</head>
<body>

<!-- ===== WAR INTEL â€” pre-arena intelligence briefing ===== -->
<div id="intel-overlay">
  <div class="intel-scanline"></div>
