// Derive a liquidity summary from flowEntities (engine passes flow through; the
// UI aggregates for display â€” buys/sells/net/distinctMakers).
function liqOf(w){
  let inflow=0,outflow=0,buys=0,sells=0; const makers=new Set();
  (w.flow||[]).forEach(f=>{ makers.add(f.maker); if(f.side==="buy"){inflow+=f.amountUsd;buys++;} else {outflow+=f.amountUsd;sells++;} });
  return { inflow, outflow, net:inflow-outflow, buys, sells, distinctMakers:makers.size };
}
const MOOD_HEX = { ATTACK:"#5b8cff", DOMINANCE:"#5b8cff", ACCUMULATION:"#4fd0a8", EMERGING:"#6fb6ff", DISTRIBUTION:"#f0b64d", BLEEDING:"#ff5d6c", COLLAPSE:"#ff5d6c", DORMANT:"#5a6577" };
const QUAL_HEX = { COMPLETE:"#4fd0a8", PARTIAL:"#f0b64d", STALE:"#93a0b5", INSUFFICIENT:"#5a6577" };
