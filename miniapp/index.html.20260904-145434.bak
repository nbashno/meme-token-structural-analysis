  <button class="intel-enter" id="intel-enter">ENTER ARENA â†’</button>
</div>

<!-- ===== BATTLEFIELD ARENA canvases (persistent background, shown on galaxy screen) ===== -->
<canvas id="gbg"></canvas>
<canvas id="gl"></canvas>
<div id="gLabels"></div>

<!-- ===== AURORA MESH â€” living background ===== -->
<div class="aurora"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>

<!-- ============ CONSENT GATE (blocks entry until agreed) ============ -->
<div id="consent-gate" style="position:fixed;inset:0;z-index:9999;background:#080a12;display:flex;flex-direction:column;padding:22px 20px;overflow-y:auto">
  <div style="font-family:var(--mono);font-weight:700;letter-spacing:.22em;font-size:15px;text-align:center;margin:8px 0 4px;text-shadow:0 0 18px rgba(91,140,255,.4)">WAR ARENA</div>
  <div style="text-align:center;color:var(--faint);font-family:var(--mono);font-size:10px;letter-spacing:.14em;margin-bottom:18px">BEFORE YOU ENTER</div>

  <div style="background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;font-size:13px;line-height:1.6;color:var(--sub)">
    <p style="margin:0 0 12px"><b style="color:var(--ink)">WAR Arena is an analytics tool, not financial advice.</b> It presents on-chain market signals for Solana tokens sourced from third-party data (GMGN). It does not predict prices, recommend trades, or guarantee any outcome. Crypto trading carries substantial risk of total loss.</p>
    <p style="margin:0 0 12px">By entering you confirm that you: are of legal age in your jurisdiction; are solely responsible for your own trading decisions; understand data may be incomplete, delayed, or marked <span style="font-family:var(--mono);color:var(--gold)">INSUFFICIENT</span>; and accept that payments (Telegram Stars / TON) for scans, monitoring, and credit are consumed as used.</p>
    <p style="margin:0">Please read the full <a id="lnk-terms" style="color:var(--power);cursor:pointer">Terms of Service</a> and <a id="lnk-privacy" style="color:var(--power);cursor:pointer">Privacy Policy</a>.</p>
  </div>

  <label style="display:flex;align-items:flex-start;gap:11px;margin:18px 4px;cursor:pointer">
    <input type="checkbox" id="consent-check" style="width:22px;height:22px;flex-shrink:0;margin-top:1px;accent-color:#5b8cff" />
    <span style="font-size:13px;line-height:1.5">I have read and agree to the <b style="color:var(--ink)">Terms of Service</b> and <b style="color:var(--ink)">Privacy Policy</b>, and I understand this is not financial advice.</span>
  </label>

  <button id="consent-enter" class="btn" style="width:100%;padding:15px;opacity:.5;margin-top:auto" disabled>Enter WAR Arena</button>
  <div style="text-align:center;color:var(--faint);font-family:var(--mono);font-size:9px;margin-top:12px">Your agreement is recorded with a timestamp.</div>
</div>

<!-- ============ LEGAL DOC OVERLAY ============ -->
<div id="legal-overlay" style="position:fixed;inset:0;z-index:10000;background:#080a12;display:none;flex-direction:column">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line)">
    <div id="legal-title" style="font-family:var(--mono);font-size:13px;font-weight:700">Terms</div>
    <button id="legal-close" style="background:var(--panel2);border:1px solid var(--line);color:var(--sub);border-radius:8px;width:30px;height:30px;cursor:pointer;font-size:15px">&times;</button>
  </div>
  <div id="legal-body" style="flex:1;overflow-y:auto;padding:18px 20px;font-size:13px;line-height:1.65;color:var(--sub)"></div>
</div>

<!-- ============ MEMBERSHIP GATE OVERLAY ============ -->
<div id="member-overlay" style="position:fixed;inset:0;z-index:9998;background:#080a12;display:none;flex-direction:column;align-items:center;justify-content:center;padding:28px 22px;text-align:center">
  <div style="font-size:44px;margin-bottom:14px">ðŸ“¡</div>
  <div style="font-family:var(--mono);font-weight:700;letter-spacing:.06em;font-size:16px;color:var(--ink);margin-bottom:10px">Join the channel to run operations</div>
  <div style="color:var(--sub);font-size:13px;line-height:1.6;max-width:320px;margin-bottom:22px">Browsing the Arena is open to everyone. To run a scan or start monitoring, join our channel first â€” it takes a second.</div>
  <a id="member-join" class="btn gold" style="width:100%;max-width:280px;padding:14px;text-decoration:none;display:block" target="_blank" rel="noopener">Join channel</a>
  <button id="member-recheck" class="btn" style="width:100%;max-width:280px;padding:12px;margin-top:10px;background:var(--panel2)">I've joined â€” check again</button>
  <button id="member-close" style="margin-top:16px;background:none;border:none;color:var(--faint);font-size:12px;cursor:pointer;text-decoration:underline">Back to browsing</button>
</div>

<!-- ============ ONBOARDING / FREE-MODEL EXPLAINER ============ -->
<div id="onboard-overlay" style="position:fixed;inset:0;z-index:9997;background:rgba(6,8,18,.55);backdrop-filter:blur(6px);display:none;flex-direction:column;align-items:center;justify-content:center;padding:24px 20px;overflow-y:auto">
  <div class="glass" style="max-width:380px;width:100%;padding:24px;margin:0;animation:rise .5s cubic-bezier(.2,.8,.2,1)">
    <div style="text-align:center;font-size:34px;margin-bottom:6px">ðŸ›°</div>
    <div style="text-align:center;font-family:var(--mono);font-weight:700;letter-spacing:.06em;font-size:16px;margin-bottom:4px">Welcome to WAR ARENA</div>
    <div style="text-align:center;color:var(--sub);font-size:12px;margin-bottom:20px">Launch month â€” here's what's free</div>
    <div style="display:grid;gap:12px">
      <div style="background:linear-gradient(160deg,rgba(79,208,168,.12),transparent);border:1px solid rgba(79,208,168,.3);border-radius:13px;padding:14px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px"><span style="font-size:18px">ðŸ”</span><b style="font-size:14px;color:var(--green)">3 free scans / day</b></div>
        <div style="color:var(--sub);font-size:12px;line-height:1.55">Analyze any token's live battlefield â€” 3 times a day, free, this month. A counter shows what's left; it resets every day.</div>
      </div>
      <div style="background:linear-gradient(160deg,rgba(240,182,77,.12),transparent);border:1px solid rgba(240,182,77,.3);border-radius:13px;padding:14px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px"><span style="font-size:18px">ðŸ›°</span><b style="font-size:14px;color:var(--gold)">1 free 24h monitor / week</b></div>
        <div style="color:var(--sub);font-size:12px;line-height:1.55">Track a token around the clock for 24 hours â€” once a week, free, this month (4 total). A timer shows when your next free monitor unlocks.</div>
      </div>
    </div>
    <div style="margin-top:16px;padding:13px;border:1px solid var(--line);border-radius:13px;background:rgba(0,0,0,.2)">
      <div style="font-family:var(--mono);font-size:9px;letter-spacing:.16em;color:var(--faint);margin-bottom:8px">AFTER THE FREE QUOTA / AFTER LAUNCH MONTH</div>
      <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--sub);margin-bottom:5px"><span>Extra scan</span><b style="color:var(--ink);font-family:var(--mono)">$0.10</b></div>
      <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--sub)"><span>24h monitor</span><b style="color:var(--ink);font-family:var(--mono)">$1.00</b></div>
      <div style="color:var(--faint);font-size:11px;line-height:1.5;margin-top:9px">Pay only when you exceed the free quota. Top up your balance anytime in <b>My Account</b>. Browsing the arena is always free.</div>
    </div>
    <button id="onboard-close" class="cta" style="margin-top:18px">Enter the arena</button>
    <div style="text-align:center;margin-top:10px"><label style="font-family:var(--mono);font-size:10px;color:var(--faint);cursor:pointer"><input type="checkbox" id="onboard-dismiss" style="vertical-align:middle;margin-right:5px">Don't show this again</label></div>
  </div>
</div>



<!-- ============ GALAXY (browse, free) ============ -->
<div class="screen on" id="s-galaxy">
  <div class="topbar">
    <div class="brand">WAR ARENA</div>
    <div class="wallet" id="wallet-top">â€¦</div>
  </div>
