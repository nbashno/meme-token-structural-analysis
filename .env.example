# ============================================================================
# WAR ARENA — Environment configuration (.env)
# ============================================================================
# Copy this file to `.env` and fill the blanks. On Koyeb / your VPS you set
# these in the dashboard's Environment section instead of a file.
#
# Two sections:
#   [A] ACTIVE  — the code reads these NOW. Fill them to run.
#   [B] STAGED  — placeholders for services not yet wired into the code
#                 (Supabase, Vercel). Safe to leave blank until we connect them.
# ============================================================================


# ============================================================================
# [A] ACTIVE — read by the code today
# ============================================================================

# ---- Server (ready — usually no need to change) ----
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ---- GMGN (REQUIRED for live data) ----
# Get your key from https://gmgn.ai/ai  (a demo key exists but is rate-limited).
# Without this the engine cannot pull on-chain data.
GMGN_API_KEY=

# ---- Telegram bot (REQUIRED for the Mini App + auth + membership) ----
# From @BotFather. Powers user auth (initData), channel membership checks,
# and (later) Stars payments. The bot MUST be an ADMIN of REQUIRED_CHANNEL
# below, or membership verification fails closed.
TELEGRAM_BOT_TOKEN=

# ---- CORS (REQUIRED once the Mini App is hosted) ----
# The exact origin the Mini App is served from, e.g. https://app.yourdomain.com
# Leave blank only while testing locally. Comma-separated for multiple origins.
CORS_ORIGIN=

# ---- Launch free window (OPTIONAL) ----
# ISO date. While "now" is before this, ALL operations are free (no charge,
# no free-scan consumed). Empty = feature off (normal pricing applies).
# Example: FREE_UNTIL=2026-10-01T00:00:00Z
FREE_UNTIL=

# ---- Channel membership gate (OPTIONAL) ----
# Require users to join a Telegram channel before running operations
# (browsing stays open). @username or numeric id. Empty = no gate.
# IMPORTANT: add the bot as an ADMIN of this channel, or checks fail closed.
# Example: REQUIRED_CHANNEL=@WarArena
REQUIRED_CHANNEL=

# ---- Arena trending view (OPTIONAL, has safe defaults) ----
# Tokens shown in the arena's opening "top battles" view, until a confirmed
# GMGN trending-address feed is wired. Format: chain:address,chain:address
# Chains: sol | bsc | base | eth. Empty = honest "no trending yet" state.
# Example: TRENDING_SEED=sol:So11111111111111111111111111111111111111112,bsc:0xABC...
TRENDING_SEED=
# How often the trending snapshot refreshes (hours). Default 4. Refresh is lazy:
# the first request after the window triggers ONE refresh; others get the cache.
# GMGN is hit at most once per window regardless of traffic.
TRENDING_TTL_HOURS=4

# Postgres / Supabase connection string. When SET, persistence uses Postgres
# and data survives restarts (essential under scale-to-zero). When BLANK, the
# app falls back to in-memory storage (resets on every restart). The schema in
# migrations/0001_init.sql is applied automatically on boot.
# Supabase: Settings > Database > Connection string (URI). Keep SECRET.
#   Use the POOLER (port 6543) connection string for serverless/scale-to-zero.
DATABASE_URL=


# ============================================================================
# [B] STAGED — NOT yet read by the code (placeholders for the next phase)
# ----------------------------------------------------------------------------
# The app currently uses in-memory storage. These are here so your deploy
# config is ready; wiring them (tables + migrations + swapping the in-memory
# layers for Postgres-backed ones) is a separate, tested step. Leaving them
# blank changes nothing today.
# ============================================================================

# ---- Supabase (Postgres persistence) ----
# The DIRECT connection string is now ACTIVE — see [A] above (DATABASE_URL).
# These extra Supabase keys remain STAGED (only needed if you later use the
# Supabase JS client / auth / storage rather than the direct Postgres pool).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Vercel (only if you host the Mini App / static pages there — STAGED) ----
# Not required to run the backend. If the Mini App + terms/privacy live on
# Vercel, set CORS_ORIGIN above to that Vercel URL. These two are only for
# programmatic deploys and are optional.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
